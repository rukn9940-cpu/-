{% extends 'layouts.master' %}

{% block title %}{{ trans('search.results_for')|default('نتائج البحث عن') }} "{{ keyword|default('') }}" — {{ store.name }}{% endblock %}

{% block seo %}
  {% if products is empty %}<meta name="robots" content="noindex,follow">{% endif %}
  <link rel="canonical" href="{{ url.current }}">
{% endblock %}

{% block content %}
{% set products = products|default([]) %}
<div class="rkn-container py-8">
  <header class="mb-6">
    <p class="text-sm text-content-muted">{{ trans('search.results_for')|default('نتائج البحث عن') }}</p>
    <h1 class="text-2xl font-extrabold text-content md:text-3xl">"{{ keyword|default('') }}"</h1>
    <p class="mt-1 text-sm text-content-subtle">{{ products.total|default(products|length) }} {{ trans('category.results')|default('نتيجة') }}</p>
  </header>

  {% if products is not empty %}
    <div class="mb-5 flex justify-end">{% include 'components.sort' %}</div>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-4">
      {% for product in products %}{% include 'components.product-card' with { product: product } %}{% endfor %}
    </div>
    <div class="mt-10">{% include 'components.pagination' with { current: products.current_page|default(1), total: products.last_page|default(1), base: '?s=' ~ keyword ~ '&page={page}' } %}</div>
  {% else %}
    {% include 'components.empty-state' with { icon: 'box', title: trans('search.no_results_title')|default('لا توجد نتائج'), message: trans('search.no_results_message')|default('جرّب كلمات بحث مختلفة أو تصفّح الأقسام.'), ctaLabel: trans('common.view_all')|default('عرض الكل'), ctaHref: '/products' } %}
  {% endif %}
</div>
{% endblock %}
