{#
  pages/installation.twig — Installation Booking
  @summary  Service intro, how-it-works steps, and a booking request form
            (service type, city, preferred date, details). Trust reinforcement.
            Full booking feature/calendar lands in Phase 5.
#}
{% extends 'layouts/master.twig' %}

{% block content %}
{% include 'components/common/breadcrumb.twig' with { items: [{ name: trans('nav.installation'), url: '/installation' }] } only %}

<div class="rkn-container py-8">
  <header class="mb-8 max-w-2xl">
    <span class="rkn-badge rkn-badge--primary">{{ trans('nav.installation') }}</span>
    <h1 class="mt-3 text-2xl font-extrabold text-content md:text-3xl">{{ trans('install.title')|default('احجز خدمة تركيب احترافية') }}</h1>
    <p class="mt-2 text-content-muted">{{ trans('install.subtitle')|default('فنيون معتمدون، ضمان على التركيب، ومواعيد مرنة في جميع مناطق المملكة.') }}</p>
  </header>

  <div class="grid gap-8 lg:grid-cols-[1fr_360px]">
    {# Booking form #}
    <form class="rkn-card space-y-4 p-6" x-data="{ state:'idle', msg:'' }"
          @submit.prevent="state='loading'; (window.salla?.contacts?.send?.(Object.fromEntries(new FormData($el))) ?? Promise.reject())
            .then(()=>{state='success'; msg='{{ trans('install.booked')|default('تم استلام طلب الحجز، سنؤكد الموعد قريبًا.') }}'; $el.reset();})
            .catch(()=>{state='error'; msg='{{ trans('common.error_generic') }}';})">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rkn-field"><label class="rkn-label rkn-label--required" for="i-name">{{ trans('contact.name')|default('الاسم') }}</label><input id="i-name" name="name" class="rkn-input" required></div>
        <div class="rkn-field"><label class="rkn-label rkn-label--required" for="i-phone">{{ trans('contact.phone')|default('رقم الجوال') }}</label><input id="i-phone" name="phone" type="tel" class="rkn-input" required></div>
        <div class="rkn-field">
          <label class="rkn-label rkn-label--required" for="i-service">{{ trans('install.service_type')|default('نوع الخدمة') }}</label>
          <select id="i-service" name="service" class="rkn-select" required>
            <option value="">{{ trans('install.choose')|default('اختر…') }}</option>
            <option>{{ trans('install.cameras')|default('تركيب كاميرات مراقبة') }}</option>
            <option>{{ trans('install.access')|default('أنظمة دخول وتحكم') }}</option>
            <option>{{ trans('install.network')|default('شبكات وبنية تحتية') }}</option>
            <option>{{ trans('install.maintenance')|default('صيانة نظام قائم') }}</option>
          </select>
        </div>
        <div class="rkn-field"><label class="rkn-label rkn-label--required" for="i-city">{{ trans('business.city')|default('المدينة') }}</label><input id="i-city" name="city" class="rkn-input" required></div>
        <div class="rkn-field"><label class="rkn-label" for="i-date">{{ trans('install.preferred_date')|default('الموعد المفضل') }}</label><input id="i-date" name="date" type="date" class="rkn-input"></div>
        <div class="rkn-field"><label class="rkn-label" for="i-count">{{ trans('install.units')|default('عدد الوحدات تقريبًا') }}</label><input id="i-count" name="units" type="number" min="1" class="rkn-input"></div>
      </div>
      <div class="rkn-field"><label class="rkn-label" for="i-details">{{ trans('business.details')|default('تفاصيل إضافية') }}</label><textarea id="i-details" name="message" class="rkn-textarea"></textarea></div>
      <button class="rkn-btn rkn-btn--primary rkn-btn--lg" :disabled="state==='loading'">
        <span x-show="state!=='loading'">{{ trans('install.book')|default('احجز الآن') }}</span>
        <span x-show="state==='loading'" x-cloak>{{ trans('common.loading') }}</span>
      </button>
      <p x-show="msg" x-cloak aria-live="polite" class="text-sm" :class="state==='success' ? 'text-success-600' : 'text-danger-600'" x-text="msg"></p>
    </form>

    {# How it works + trust #}
    <aside class="space-y-4">
      <div class="rkn-card p-6">
        <h2 class="mb-4 text-base font-bold">{{ trans('install.how')|default('كيف تتم العملية') }}</h2>
        <ol class="space-y-4">
          {% set steps = ['تعبئة طلب الحجز', 'تأكيد الموعد ومعاينة (إن لزم)', 'التركيب والاختبار', 'التشغيل والضمان'] %}
          {% for step in steps %}
            <li class="flex items-start gap-3">
              <span class="grid size-7 shrink-0 place-items-center rounded-full bg-primary-600 text-xs font-bold text-white">{{ loop.index }}</span>
              <span class="text-sm text-content-muted">{{ step }}</span>
            </li>
          {% endfor %}
        </ol>
      </div>
      {% include 'components/trust/trust-badges.twig' with { layout: 'inline' } only %}
    </aside>
  </div>
</div>
{% endblock %}
