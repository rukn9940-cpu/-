{% extends 'layouts.master' %}

{% block title %}{{ error.code|default(404) }} — {{ store.name }}{% endblock %}

{% block seo %}<meta name="robots" content="noindex,follow">{% endblock %}

{% block content %}
<div class="rkn-container">
  <div class="mx-auto flex max-w-md flex-col items-center px-4 py-20 text-center" role="alert">
    <p class="text-7xl font-extrabold tracking-tight text-primary-600">{{ error.code|default(404) }}</p>
    <h1 class="mt-3 text-xl font-bold text-content">{{ error.title|default(trans('error.not_found')|default('الصفحة غير موجودة')) }}</h1>
    <p class="mt-2 text-sm text-content-muted">{{ error.message|default(trans('error.not_found_message')|default('عذرًا، لم نتمكن من العثور على الصفحة التي تبحث عنها.')) }}</p>
    <div class="mt-6 flex gap-3">
      <a href="{{ url.home|default('/') }}" class="rkn-btn rkn-btn--primary">{{ trans('common.back_home')|default('العودة للرئيسية') }}</a>
      <a href="/products" class="rkn-btn rkn-btn--outline">{{ trans('common.view_all')|default('تصفّح المنتجات') }}</a>
    </div>
  </div>
</div>
{% endblock %}
