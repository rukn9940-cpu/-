{% extends 'layouts.master' %}

{% block title %}{{ trans('cart.title')|default('سلة المشتريات') }} — {{ store.name }}{% endblock %}

{% block content %}
<div class="rkn-container py-8" x-data>
  <h1 class="mb-6 text-2xl font-extrabold text-content md:text-3xl">{{ trans('cart.title')|default('سلة المشتريات') }}</h1>

  <div x-show="$store.badges.cart === 0">
    {% include 'components.empty-state' with { icon: 'cart', title: trans('cart.empty')|default('سلة المشتريات فارغة'), message: trans('cart.empty_message')|default('لم تقم بإضافة أي منتجات بعد.'), ctaLabel: trans('common.start_shopping')|default('ابدأ التسوق'), ctaHref: '/' } %}
  </div>

  <div x-show="$store.badges.cart > 0" x-cloak class="grid gap-8 lg:grid-cols-[1fr_360px]">
    <div class="rkn-card p-4 md:p-6"><salla-cart-summary></salla-cart-summary></div>

    <aside class="space-y-4 self-start lg:sticky lg:top-24">
      <div class="rkn-card p-5">
        <h2 class="mb-4 text-lg font-bold">{{ trans('cart.order_summary')|default('ملخص الطلب') }}</h2>
        <form class="mb-4 flex gap-2" @submit.prevent="window.salla?.cart?.addCoupon?.($refs.coupon.value)">
          <label for="coupon" class="sr-only">{{ trans('cart.coupon')|default('كود الخصم') }}</label>
          <input id="coupon" x-ref="coupon" class="rkn-input" placeholder="{{ trans('cart.coupon')|default('كود الخصم') }}">
          <button class="rkn-btn rkn-btn--outline whitespace-nowrap">{{ trans('cart.apply')|default('تطبيق') }}</button>
        </form>
        <a href="{{ url.get('checkout')|default('/checkout') }}" class="rkn-btn rkn-btn--primary rkn-btn--block rkn-btn--lg">{{ trans('cart.checkout')|default('إتمام الطلب') }}</a>
        <a href="/" class="rkn-btn rkn-btn--ghost rkn-btn--block mt-2">{{ trans('cart.continue_shopping')|default('متابعة التسوق') }}</a>
      </div>
      {% include 'components.trust-badges' with { layout: 'inline' } %}
    </aside>
  </div>

  <section class="rkn-section">
    <h2 class="mb-6 text-xl font-extrabold text-content md:text-2xl">{{ trans('cart.you_may_like')|default('قد يعجبك أيضًا') }}</h2>
    <salla-products-slider source="sales" limit="10"></salla-products-slider>
  </section>
</div>
{% endblock %}
