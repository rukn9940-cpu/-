{% extends 'layouts.master' %}

{% block title %}{{ trans('account.wishlist')|default('المفضلة') }} — {{ store.name }}{% endblock %}

{% block content %}
<div class="rkn-container py-8">
  <h1 class="mb-6 text-2xl font-extrabold text-content md:text-3xl">{{ trans('account.wishlist')|default('المفضلة') }}</h1>
  <div class="grid gap-6 lg:grid-cols-[260px_1fr]">
    {% include 'components.account-sidebar' with { active: 'wishlist' } %}
    <div>
      {% set products = products|default([]) %}
      {% if products is not empty %}
        <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
          {% for product in products %}{% include 'components.product-card' with { product: product } %}{% endfor %}
        </div>
      {% else %}
        {% include 'components.empty-state' with { icon: 'star', title: trans('wishlist.empty_title')|default('قائمة المفضلة فارغة'), message: trans('wishlist.empty_message')|default('أضف المنتجات التي تحبها لمتابعتها لاحقًا.'), ctaLabel: trans('common.start_shopping')|default('ابدأ التسوق'), ctaHref: '/' } %}
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
