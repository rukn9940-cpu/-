{% extends 'layouts.master' %}

{% block title %}{{ category.name|default(trans('nav.categories')|default('الأقسام')) }} — {{ store.name }}{% endblock %}

{% block content %}
{% set products = products|default([]) %}
{% set current_page = products.current_page|default(1) %}
{% set total_pages = products.last_page|default(1) %}

{% include 'components.breadcrumb' with { items: [{ name: category.name|default(trans('nav.categories')|default('الأقسام')), url: category.url|default('#') }] } %}

<div class="rkn-container py-6">
  <header class="mb-6">
    <h1 class="text-2xl font-extrabold text-content md:text-3xl">{{ category.name|default(trans('nav.categories')|default('الأقسام')) }}</h1>
    {% if category.description %}<p class="mt-2 max-w-3xl text-content-muted">{{ category.description }}</p>{% endif %}
  </header>

  <div class="grid gap-8 lg:grid-cols-[280px_1fr]">
    {% set filter_groups = filters|default([
      { id: 'brand', title: trans('product.brand')|default('العلامة التجارية'), type: 'checkbox', options: brands_filter|default([]) },
      { id: 'price', title: trans('category.price')|default('السعر'), type: 'price' },
      { id: 'rating', title: trans('product.reviews')|default('التقييم'), type: 'checkbox', options: [
        { value: '4', label: '4★ ' ~ (trans('category.and_up')|default('فأعلى')) },
        { value: '3', label: '3★ ' ~ (trans('category.and_up')|default('فأعلى')) }
      ] }
    ]) %}
    <div>{% include 'components.filters' with { groups: filter_groups } %}</div>

    <div>
      <div class="mb-5 flex items-center justify-between gap-3">
        <p class="text-sm text-content-muted">{{ products.total|default(products|length) }} {{ trans('category.results')|default('نتيجة') }}</p>
        {% include 'components.sort' %}
      </div>

      {% if products is not empty %}
        <div class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-4">
          {% for product in products %}{% include 'components.product-card' with { product: product } %}{% endfor %}
        </div>
        <div class="mt-10">{% include 'components.pagination' with { current: current_page, total: total_pages, base: (category.url|default('/products')) ~ '?page={page}' } %}</div>
      {% else %}
        {% include 'components.empty-state' with { icon: 'box', title: trans('category.empty_title')|default('لا توجد منتجات'), message: trans('category.empty_message')|default('لم نجد منتجات في هذا القسم حاليًا.'), ctaLabel: trans('common.view_all')|default('عرض الكل'), ctaHref: '/products' } %}
      {% endif %}
    </div>
  </div>
</div>

{% include 'components.recently-viewed' %}
{% endblock %}
