{% extends 'layouts.master' %}

{% block title %}{{ product.name }} — {{ store.name }}{% endblock %}

{% block seo %}
  <meta name="description" content="{{ (product.short_description|default(product.description))|striptags|slice(0, 160) }}">
  <link rel="canonical" href="{{ product.url|default(url.current) }}">
  <meta property="og:type" content="product">
  <meta property="og:title" content="{{ product.name }}">
  <meta property="og:description" content="{{ (product.short_description|default(product.description))|striptags|slice(0, 160) }}">
  {% if product.image %}<meta property="og:image" content="{{ product.image.url|default(product.image) }}">{% endif %}
  <meta property="product:price:amount" content="{{ product.sale_price|default(product.price) }}">
  <meta property="product:price:currency" content="{{ store.currency|default('SAR') }}">
{% endblock %}

{% block content %}
{% set p = product %}

{% include 'components.breadcrumb' with { items: [
  { name: p.category.name|default(trans('nav.categories')|default('الأقسام')), url: p.category.url|default('#') },
  { name: p.name, url: p.url }
] } %}

<div class="rkn-container py-6">
  <div class="grid gap-8 lg:grid-cols-2">
    {% include 'components.product-gallery' with { product: p } %}
    {% include 'components.product-info' with { product: p } %}
  </div>
  <div class="mt-10">{% include 'components.product-tabs' with { product: p } %}</div>
</div>

{% include 'components.related-products' with { source: 'related', sourceValue: p.id } %}
{% include 'components.recently-viewed' %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ p.name|json_encode|raw }},
  "sku": {{ (p.sku|default(''))|json_encode|raw }},
  {% if p.brand.name is defined %}"brand": { "@type": "Brand", "name": {{ p.brand.name|json_encode|raw }} },{% endif %}
  {% if p.image %}"image": {{ (p.image.url|default(p.image))|json_encode|raw }},{% endif %}
  "description": {{ (p.short_description|default(p.description|default('')))|striptags|json_encode|raw }},
  "offers": {
    "@type": "Offer",
    "price": "{{ p.sale_price|default(p.price) }}",
    "priceCurrency": "{{ store.currency|default('SAR') }}",
    "availability": "{{ p.is_out_of_stock|default(false) ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock' }}",
    "url": {{ p.url|json_encode|raw }}
  }{% if p.rating is defined and (p.rating.count|default(p.reviews_count)|default(0)) > 0 %},
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "{{ p.rating.average|default(p.rating.stars)|default(p.rating) }}", "reviewCount": "{{ p.rating.count|default(p.reviews_count)|default(0) }}" }{% endif %}
}
</script>
{% endblock %}
