{% extends 'layouts.master' %}

{% block content %}

{% include 'components.hero' %}

{# Shop by category — renders real store categories when available #}
{% set categories = categories|default(theme.settings.home_categories)|default([]) %}
{% if categories is not empty %}
<section class="rkn-section" aria-label="{{ trans('home.shop_by_category')|default('تسوّق حسب القسم') }}">
  <div class="rkn-container">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="text-xl font-extrabold text-content md:text-2xl">{{ trans('home.shop_by_category')|default('تسوّق حسب القسم') }}</h2>
      <a href="{{ url.get('categories')|default('/categories') }}" class="rkn-btn rkn-btn--ghost rkn-btn--sm">{{ trans('common.view_all')|default('عرض الكل') }}</a>
    </div>
    <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6">
      {% for category in categories %}
        {% include 'components.category-card' with { category: category, variant: 'tile' } %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# Flash deals #}
<section class="rkn-section" aria-label="{{ trans('home.flash_deals')|default('عروض سريعة') }}">
  <div class="rkn-container">
    <div class="mb-6 flex items-center gap-3">
      <span class="grid size-11 place-items-center rounded-xl bg-secondary-50 text-secondary-700">
        <svg class="size-6" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4 14h6l-1 8 9-12h-6z"/></svg>
      </span>
      <h2 class="text-xl font-extrabold text-content md:text-2xl">{{ trans('home.flash_deals')|default('عروض سريعة') }}</h2>
    </div>
    <salla-products-slider source="offers" source-value="{{ theme.settings.collection_offers|default('') }}" limit="12"></salla-products-slider>
  </div>
</section>

{# Best sellers #}
<section class="rkn-section bg-surface-sunken" aria-label="{{ trans('home.best_sellers')|default('الأكثر مبيعًا') }}">
  <div class="rkn-container">
    <h2 class="mb-6 text-xl font-extrabold text-content md:text-2xl">{{ trans('home.best_sellers')|default('الأكثر مبيعًا') }}</h2>
    <salla-products-slider source="sales" limit="12"></salla-products-slider>
  </div>
</section>

{# Category collections #}
{% set collections = [
  { title: trans('cat.ip')|default('كاميرات IP'), key: 'collection_ip' },
  { title: trans('cat.solar')|default('الكاميرات الشمسية'), key: 'collection_solar' },
  { title: trans('cat.4g')|default('كاميرات 4G'), key: 'collection_4g' },
  { title: trans('cat.wifi')|default('كاميرات واي فاي'), key: 'collection_wifi' },
  { title: trans('cat.nvr')|default('أجهزة NVR و DVR'), key: 'collection_nvr' },
  { title: trans('cat.accessories')|default('الإكسسوارات وهاردات التخزين'), key: 'collection_accessories' }
] %}
{% for col in collections %}
  {% set cid = attribute(theme.settings, col.key)|default('') %}
  {% if cid %}
    <section class="rkn-section" aria-label="{{ col.title }}">
      <div class="rkn-container">
        <h2 class="mb-6 text-xl font-extrabold text-content md:text-2xl">{{ col.title }}</h2>
        <salla-products-slider source="categories" source-value="{{ cid }}" limit="12"></salla-products-slider>
      </div>
    </section>
  {% endif %}
{% endfor %}

{# Business solutions banner #}
<section class="rkn-section">
  <div class="rkn-container">
    <div class="relative overflow-hidden rounded-2xl bg-accent px-6 py-12 text-center text-content-inverse md:px-12 md:py-16">
      <div class="pointer-events-none absolute -inset-block-start-16 -inset-inline-end-16 size-64 rounded-full bg-white/10 blur-2xl"></div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="text-2xl font-extrabold md:text-4xl">{{ trans('home.business_title')|default('حلول أمنية للأعمال والمشاريع') }}</h2>
        <p class="mt-3 text-content-inverse/85">{{ trans('home.business_sub')|default('تصميم وتوريد وتركيب أنظمة المراقبة للشركات والمنشآت بعقود صيانة متكاملة.') }}</p>
        <a href="{{ url.get('business')|default('/business') }}" class="rkn-btn rkn-btn--secondary rkn-btn--lg mt-7">{{ trans('home.request_quote')|default('اطلب عرض سعر') }}</a>
      </div>
    </div>
  </div>
</section>

{# Installation services banner #}
<section class="rkn-section">
  <div class="rkn-container">
    <div class="grid items-center gap-6 overflow-hidden rounded-2xl border border-border bg-surface p-6 md:grid-cols-2 md:p-10">
      <div>
        <span class="rkn-badge rkn-badge--primary">{{ trans('nav.installation')|default('خدمات التركيب') }}</span>
        <h2 class="mt-3 text-2xl font-extrabold text-content md:text-3xl">{{ trans('home.install_title')|default('خدمة تركيب احترافية معتمدة') }}</h2>
        <p class="mt-3 text-content-muted">{{ trans('home.install_sub')|default('فنيون معتمدون، ضمان على التركيب، ومواعيد مرنة في جميع مناطق المملكة.') }}</p>
        <a href="{{ url.get('installation')|default('/installation') }}" class="rkn-btn rkn-btn--primary rkn-btn--lg mt-6">{{ trans('home.book_installation')|default('احجز موعد تركيب') }}</a>
      </div>
      <div class="grid grid-cols-3 gap-3 text-center">
        {% for stat in [{ n: '+5000', l: trans('home.stat_installs')|default('عملية تركيب') }, { n: '24/7', l: trans('home.stat_support')|default('دعم فني') }, { n: '+10', l: trans('home.stat_years')|default('سنوات خبرة') }] %}
          <div class="rounded-xl bg-surface-sunken p-4">
            <p class="text-xl font-extrabold text-primary-700">{{ stat.n }}</p>
            <p class="mt-1 text-xs text-content-muted">{{ stat.l }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# Why choose RKN #}
<section class="rkn-section bg-surface-sunken" aria-label="{{ trans('home.why_choose')|default('لماذا ركن الاحتراف؟') }}">
  <div class="rkn-container">
    <div class="mb-8 text-center">
      <h2 class="text-2xl font-extrabold text-content md:text-3xl">{{ trans('home.why_choose')|default('لماذا ركن الاحتراف؟') }}</h2>
      <p class="mx-auto mt-2 max-w-2xl text-content-muted">{{ trans('home.why_choose_sub')|default('شريكك الموثوق في حلول الأمن والمراقبة بالمملكة العربية السعودية.') }}</p>
    </div>
    <ul class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {% set features = [
        { icon: 'shield', t: trans('trust.warranty')|default('ضمان معتمد'), d: trans('trust.warranty_text')|default('ضمان رسمي على جميع المنتجات') },
        { icon: 'badge-check', t: trans('trust.authentic')|default('منتجات أصلية'), d: trans('trust.authentic_text')|default('منتجات أصلية 100%') },
        { icon: 'lock', t: trans('trust.secure_checkout')|default('دفع آمن'), d: trans('trust.secure_text')|default('دفع آمن ومشفّر') },
        { icon: 'tool', t: trans('trust.installation_available')|default('تركيب احترافي'), d: trans('trust.installation_text')|default('تركيب معتمد بضمان') }
      ] %}
      {% for f in features %}
        <li class="flex flex-col items-center gap-2 rounded-xl border border-border bg-surface p-5 text-center">
          <span class="grid size-12 place-items-center rounded-full bg-primary-50 text-primary-600"><svg class="size-6" aria-hidden="true"><use href="#icon-{{ f.icon }}"></use></svg></span>
          <span class="text-sm font-bold text-content">{{ f.t }}</span>
          <span class="text-xs text-content-muted">{{ f.d }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% endblock %}
