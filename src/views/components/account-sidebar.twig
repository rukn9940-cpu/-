{% set items = [
  { key: 'dashboard', label: trans('account.dashboard')|default('لوحة التحكم'), url: url.get('profile')|default('/profile'), icon: 'box' },
  { key: 'orders', label: trans('account.orders')|default('طلباتي'), url: url.get('orders')|default('/orders'), icon: 'cart' },
  { key: 'wishlist', label: trans('account.wishlist')|default('المفضلة'), url: url.get('wishlist')|default('/wishlist'), icon: 'star' },
  { key: 'addresses', label: trans('account.addresses')|default('العناوين'), url: url.get('profile.addresses')|default('/profile/addresses'), icon: 'box' },
  { key: 'settings', label: trans('account.settings')|default('الإعدادات'), url: url.get('profile.edit')|default('/profile/edit'), icon: 'tool' }
] %}
<nav class="rkn-card p-2" aria-label="{{ trans('account.my_account')|default('حسابي') }}">
  <ul class="space-y-0.5">
    {% for item in items %}
      <li><a href="{{ item.url }}" class="rkn-navlink w-full justify-start {{ active|default('') == item.key ? 'rkn-navlink--active bg-surface-sunken' : '' }}" {{ active|default('') == item.key ? 'aria-current=page' : '' }}><svg class="size-5" aria-hidden="true"><use href="#icon-{{ item.icon }}"></use></svg>{{ item.label }}</a></li>
    {% endfor %}
    <li class="mt-1 border-t border-border pt-1">
      <a href="{{ url.get('logout')|default('/logout') }}" class="rkn-navlink w-full justify-start text-danger-600 hover:bg-danger-50"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h9"/></svg>{{ trans('account.logout')|default('تسجيل الخروج') }}</a>
    </li>
  </ul>
</nav>
