{% set bg = (variant|default('primary') == 'accent') ? 'bg-accent' : 'bg-primary-600' %}
<section class="rkn-section">
  <div class="rkn-container">
    <div class="relative overflow-hidden rounded-2xl {{ bg }} px-6 py-12 text-center text-content-inverse md:px-12 md:py-16">
      <div class="pointer-events-none absolute -inset-block-start-16 -inset-inline-end-16 size-64 rounded-full bg-white/10 blur-2xl"></div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="text-2xl font-extrabold md:text-4xl">{{ title }}</h2>
        {% if subtitle %}<p class="mt-3 text-base text-content-inverse/85">{{ subtitle }}</p>{% endif %}
        {% if ctaLabel and ctaHref %}<a href="{{ ctaHref }}" class="rkn-btn rkn-btn--secondary rkn-btn--lg mt-7">{{ ctaLabel }}</a>{% endif %}
      </div>
    </div>
  </div>
</section>
