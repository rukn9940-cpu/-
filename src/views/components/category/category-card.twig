{#
  category/category-card.twig — premium category tile
  @param category  object  required — { name, url, image, products_count? }
  @param variant   string  tile|overlay (default tile)
#}
{% set c = category %}
{% if variant|default('tile') == 'overlay' %}
  <a href="{{ c.url }}" class="group relative block aspect-[4/3] overflow-hidden rounded-xl bg-surface-sunken">
    <img src="{{ c.image }}" alt="{{ c.name }}" loading="lazy"
         class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
    <span class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-slate-950/10 to-transparent"></span>
    <span class="absolute inset-block-end-0 inset-inline-0 p-4">
      <span class="block text-base font-bold text-white">{{ c.name }}</span>
      {% if c.products_count is defined %}<span class="text-xs text-white/80">{{ c.products_count }} {{ trans('category.products')|default('منتج') }}</span>{% endif %}
    </span>
  </a>
{% else %}
  <a href="{{ c.url }}" class="rkn-card rkn-card--interactive group flex flex-col items-center p-5 text-center">
    <span class="mb-3 flex size-20 items-center justify-center overflow-hidden rounded-full bg-primary-50">
      <img src="{{ c.image }}" alt="{{ c.name }}" loading="lazy" class="size-14 object-contain transition duration-300 group-hover:scale-110">
    </span>
    <span class="text-sm font-semibold text-content group-hover:text-primary-700">{{ c.name }}</span>
    {% if c.products_count is defined %}<span class="mt-0.5 text-xs text-content-subtle">{{ c.products_count }}</span>{% endif %}
  </a>
{% endif %}
