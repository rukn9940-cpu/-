{#
  account/sidebar.twig — customer dashboard navigation
  @param active  string  current section key
  @a11y  nav landmark; current marked aria-current
#}
{% set items = [
  { key: 'dashboard', label: trans('account.dashboard')|default('لوحة التحكم'), url: '/profile', icon: 'box' },
  { key: 'orders', label: trans('account.orders'), url: '/orders', icon: 'cart' },
  { key: 'wishlist', label: trans('account.wishlist'), url: '/wishlist', icon: 'star' },
  { key: 'addresses', label: trans('account.addresses')|default('العناوين'), url: '/addresses', icon: 'box' },
  { key: 'settings', label: trans('account.settings')|default('الإعدادات'), url: '/profile/edit', icon: 'tool' }
] %}
<nav class="rkn-card p-2" aria-label="{{ trans('account.my_account') }}">
  <ul class="space-y-0.5">
    {% for item in items %}
      <li>
        <a href="{{ item.url }}" class="rkn-navlink w-full justify-start {{ active|default('') == item.key ? 'rkn-navlink--active bg-surface-sunken' : '' }}"
           {{ active|default('') == item.key ? 'aria-current=page' : '' }}>
          <svg class="size-5" aria-hidden="true"><use href="#icon-{{ item.icon }}"></use></svg>
          {{ item.label }}
        </a>
      </li>
    {% endfor %}
    <li class="border-t border-border pt-1 mt-1">
      <a href="{{ url.logout|default('/logout') }}" class="rkn-navlink w-full justify-start text-danger-600 hover:bg-danger-50">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h9"/></svg>
        {{ trans('account.logout') }}
      </a>
    </li>
  </ul>
</nav>
