{% set p = product %}
{% set on_sale = p.is_on_sale|default(false) or (p.sale_price is defined and p.sale_price) %}
{% set price = p.sale_price|default(p.price) %}
{% set image = p.image.url|default(p.image)|default(p.thumbnail)|default('') %}
{% set hover = p.images[1].url|default(p.images[1])|default('') %}
{% set discount = p.discount_percentage|default(p.sale_percentage)|default(0) %}

<article class="rkn-card rkn-card--interactive group relative flex flex-col overflow-hidden" x-data>
  {# Media #}
  <a href="{{ p.url }}" class="relative block aspect-square overflow-hidden bg-surface-sunken" aria-label="{{ p.name }}">
    <div class="pointer-events-none absolute inset-block-start-3 inset-inline-start-3 z-10 flex flex-col items-start gap-1.5">
      {% if discount > 0 %}<span class="rkn-badge rkn-badge--sale shadow-sm">-{{ discount }}%</span>{% endif %}
      {% if p.is_out_of_stock|default(false) %}<span class="rkn-badge rkn-badge--neutral shadow-sm">{{ trans('product.out_of_stock')|default('غير متوفر') }}</span>{% endif %}
      {% if p.promotion_title %}<span class="rkn-badge rkn-badge--primary shadow-sm">{{ p.promotion_title }}</span>{% endif %}
    </div>
    {% if image %}
      <img src="{{ image }}" alt="{{ p.name }}" loading="lazy" decoding="async" width="400" height="400" class="h-full w-full object-cover transition duration-500 group-hover:scale-105 {{ hover ? 'group-hover:opacity-0' : '' }}">
      {% if hover %}<img src="{{ hover }}" alt="" aria-hidden="true" loading="lazy" width="400" height="400" class="absolute inset-0 h-full w-full object-cover opacity-0 transition duration-500 group-hover:opacity-100">{% endif %}
    {% endif %}
  </a>

  {# Quick actions #}
  <div class="absolute inset-block-start-3 inset-inline-end-3 z-10 flex flex-col gap-2 opacity-0 transition duration-300 focus-within:opacity-100 group-hover:opacity-100">
    <salla-wishlist product-id="{{ p.id }}" class="grid size-9 place-items-center rounded-full border border-border bg-surface/90 text-content-muted shadow-sm backdrop-blur transition hover:border-danger-200 hover:text-danger-600" aria-label="{{ trans('product.add_to_wishlist')|default('أضف إلى المفضلة') }}">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20s-7-4.6-9.2-8.4C1 8.4 2.7 5 6 5c2 0 3.2 1.2 4 2.3C10.8 6.2 12 5 14 5c3.3 0 5 3.4 3.2 6.6C19 15.4 12 20 12 20z"/></svg>
    </salla-wishlist>
    {% if theme.settings.show_compare|default(true) %}
    <button type="button" class="grid size-9 place-items-center rounded-full border bg-surface/90 shadow-sm backdrop-blur transition" :class="$store.compare.has('{{ p.id }}') ? 'border-primary-300 text-primary-600' : 'border-border text-content-muted hover:text-primary-600'" @click="$store.compare.toggle('{{ p.id }}')" :aria-pressed="$store.compare.has('{{ p.id }}')" aria-label="{{ trans('product.compare')|default('قارن') }}">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3v18M17 3v18M3 8h8M13 16h8"/></svg>
    </button>
    {% endif %}
  </div>

  {# Body #}
  <div class="flex flex-1 flex-col p-4">
    {% if p.brand.name is defined %}<span class="mb-1 text-xs font-medium text-content-subtle">{{ p.brand.name }}</span>{% endif %}

    <h3 class="line-clamp-2 text-sm font-semibold leading-snug text-content">
      <a href="{{ p.url }}" class="text-content before:absolute before:inset-0 hover:text-primary-700">{{ p.name }}</a>
    </h3>

    {% if p.rating.stars is defined or p.rating is defined %}
      {% set stars = p.rating.stars|default(p.rating)|default(0) %}
      <span class="mt-2 inline-flex items-center gap-1.5" role="img" aria-label="{{ stars }} {{ trans('product.out_of_5')|default('من 5') }}">
        <span class="inline-flex" aria-hidden="true">
          {% for i in 1..5 %}<svg class="size-4 {{ i <= stars ? 'text-secondary-500' : 'text-slate-300' }}" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.9 4.7 17.6l1-5.8L1.5 7.7l5.9-.9z"/></svg>{% endfor %}
        </span>
        {% if p.rating.count is defined or p.reviews_count is defined %}<span class="text-xs text-content-subtle">({{ p.rating.count|default(p.reviews_count) }})</span>{% endif %}
      </span>
    {% endif %}

    <div class="mt-3 flex items-baseline gap-2">
      <span class="text-base font-extrabold text-content">{{ price|money }}</span>
      {% if on_sale and p.regular_price %}<span class="text-sm text-content-subtle line-through">{{ p.regular_price|money }}</span>{% endif %}
    </div>

    <div class="relative z-10 mt-4">
      {% if p.is_out_of_stock|default(false) %}
        <button class="rkn-btn rkn-btn--outline rkn-btn--block" disabled>{{ trans('product.out_of_stock')|default('غير متوفر') }}</button>
      {% else %}
        <salla-add-product-button product-id="{{ p.id }}" class="rkn-btn rkn-btn--primary rkn-btn--block">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.2"/><circle cx="18" cy="20" r="1.2"/></svg>
          {{ trans('cart.add_to_cart')|default('أضف إلى السلة') }}
        </salla-add-product-button>
      {% endif %}
    </div>
  </div>
</article>
