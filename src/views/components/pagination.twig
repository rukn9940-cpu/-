{% set current = current|default(1) %}
{% set total = total|default(1) %}
{% set base = base|default('?page={page}') %}
{% if total > 1 %}
<nav class="flex items-center justify-center gap-1" aria-label="{{ trans('common.pagination')|default('ترقيم الصفحات') }}">
  <a href="{{ current > 1 ? base|replace({'{page}': current - 1}) : '#' }}" class="rkn-btn rkn-btn--outline rkn-btn--icon rkn-btn--sm {{ current <= 1 ? 'pointer-events-none opacity-40' : '' }}" aria-label="{{ trans('common.previous')|default('السابق') }}" {{ current <= 1 ? 'aria-disabled=true' : '' }}>
    <svg class="size-4 rkn-flip-rtl" viewBox="0 0 20 20" fill="currentColor"><path d="M12.5 4l-6 6 6 6 1.4-1.4L9.3 10l4.6-4.6z"/></svg>
  </a>
  {% for page in 1..total %}
    {% if page == 1 or page == total or (page >= current - 1 and page <= current + 1) %}
      <a href="{{ base|replace({'{page}': page}) }}" class="rkn-btn rkn-btn--sm min-w-10 justify-center {{ page == current ? 'rkn-btn--primary' : 'rkn-btn--ghost' }}" {{ page == current ? 'aria-current=page' : '' }}>{{ page }}</a>
    {% elseif page == current - 2 or page == current + 2 %}
      <span class="px-2 text-content-subtle">…</span>
    {% endif %}
  {% endfor %}
  <a href="{{ current < total ? base|replace({'{page}': current + 1}) : '#' }}" class="rkn-btn rkn-btn--outline rkn-btn--icon rkn-btn--sm {{ current >= total ? 'pointer-events-none opacity-40' : '' }}" aria-label="{{ trans('common.next')|default('التالي') }}" {{ current >= total ? 'aria-disabled=true' : '' }}>
    <svg class="size-4 rkn-flip-rtl" viewBox="0 0 20 20" fill="currentColor"><path d="M7.5 4L6.1 5.4 10.7 10l-4.6 4.6L7.5 16l6-6z"/></svg>
  </a>
</nav>
{% endif %}
