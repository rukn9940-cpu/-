{#
  product/products-section.twig — titled collection of products
  @summary  Premium collection block used across the homepage and listings.
            Renders our own product-card carousel/grid when a `products` array
            is supplied; otherwise falls back to Salla's products-slider by
            `source` (so category/tag collections work without server data).
  @param title       string  required heading
  @param subtitle    string  optional
  @param products    array    optional Salla products → renders our cards
  @param source      string   optional Salla slider source (sales|offers|latest|category|tag|...)
  @param sourceValue string   optional source value (e.g. category id)
  @param viewAllUrl  string   optional "view all" link
  @param layout      string   carousel|grid (default carousel)
  @param icon        string   optional accent icon name
  @a11y  section[aria-label]; carousel controls labelled; RTL-aware
#}
{% set layout = layout|default('carousel') %}
{% set products = products|default([]) %}
<section class="rkn-section" aria-label="{{ title }}"
         {% if layout == 'carousel' %}x-data="rknCarousel({ autoplay: 0 })"{% endif %}>
  <div class="rkn-container">
    {# Header #}
    <div class="mb-6 flex items-end justify-between gap-4">
      <div class="flex items-center gap-3">
        {% if icon %}
          <span class="grid size-11 place-items-center rounded-xl bg-primary-50 text-primary-600">
            <svg class="size-6" aria-hidden="true"><use href="#icon-{{ icon }}"></use></svg>
          </span>
        {% endif %}
        <div>
          <h2 class="text-xl font-extrabold text-content md:text-2xl">{{ title }}</h2>
          {% if subtitle %}<p class="mt-0.5 text-sm text-content-muted">{{ subtitle }}</p>{% endif %}
        </div>
      </div>
      <div class="flex items-center gap-2">
        {% if viewAllUrl %}
          <a href="{{ viewAllUrl }}" class="rkn-btn rkn-btn--ghost rkn-btn--sm whitespace-nowrap">
            {{ trans('common.view_all') }}
            <svg class="size-4 rkn-flip-rtl" viewBox="0 0 20 20" fill="currentColor"><path d="M7.5 4L6.1 5.4 10.7 10l-4.6 4.6L7.5 16l6-6z"/></svg>
          </a>
        {% endif %}
        {% if layout == 'carousel' and products is not empty %}
          <div class="hidden gap-2 md:flex">
            <button class="rkn-btn rkn-btn--outline rkn-btn--icon" @click="prev()" :disabled="atStart" aria-label="{{ trans('common.previous')|default('السابق') }}">
              <svg class="size-5 rkn-flip-rtl" viewBox="0 0 20 20" fill="currentColor"><path d="M12.5 4l-6 6 6 6 1.4-1.4L9.3 10l4.6-4.6z"/></svg>
            </button>
            <button class="rkn-btn rkn-btn--outline rkn-btn--icon" @click="next()" :disabled="atEnd" aria-label="{{ trans('common.next')|default('التالي') }}">
              <svg class="size-5 rkn-flip-rtl" viewBox="0 0 20 20" fill="currentColor"><path d="M7.5 4L6.1 5.4 10.7 10l-4.6 4.6L7.5 16l6-6z"/></svg>
            </button>
          </div>
        {% endif %}
      </div>
    </div>

    {# Body #}
    {% if products is not empty %}
      {% if layout == 'grid' %}
        <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          {% for product in products %}
            {% include 'components/product/product-card.twig' with { product: product } only %}
          {% endfor %}
        </div>
      {% else %}
        <div x-ref="track" class="rkn-carousel__track">
          {% for product in products %}
            <div class="w-[68%] shrink-0 sm:w-[44%] md:w-[31%] lg:w-[23%]">
              {% include 'components/product/product-card.twig' with { product: product } only %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% elseif source %}
      {# Fallback: Salla fetches the collection client-side. #}
      <salla-products-slider source="{{ source }}" {% if sourceValue %}source-value="{{ sourceValue }}"{% endif %}></salla-products-slider>
    {% else %}
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4 lg:grid-cols-5">
        {% include 'components/ui/skeleton.twig' with { variant: 'product-card', count: 5 } only %}
      </div>
    {% endif %}
  </div>
</section>
