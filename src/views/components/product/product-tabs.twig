{#
  product/product-tabs.twig — description / specifications / reviews tabs
  @param product  object  required
  @param tabs     array   optional override: [{ id, label }]
  @a11y  full ARIA tabs pattern with roving arrow-key navigation (RTL-aware)
#}
{% set tabs = tabs|default([
  { id: 'description', label: trans('product.description')|default('الوصف') },
  { id: 'specs', label: trans('product.specifications') },
  { id: 'reviews', label: trans('product.reviews') }
]) %}
<div x-data="rknTabs(0)" class="rkn-card">
  <div class="flex gap-1 overflow-x-auto border-b border-border px-2 no-scrollbar" role="tablist"
       aria-label="{{ trans('product.details')|default('تفاصيل المنتج') }}">
    {% for tab in tabs %}
      <button class="relative whitespace-nowrap px-4 py-3.5 text-sm font-semibold transition"
              :class="isActive({{ loop.index0 }}) ? 'text-primary-700' : 'text-content-muted hover:text-content'"
              @click="select({{ loop.index0 }})" @keydown="onKey($event, {{ loop.index0 }}, {{ tabs|length }})"
              role="tab" :aria-selected="isActive({{ loop.index0 }})" :tabindex="isActive({{ loop.index0 }}) ? 0 : -1"
              id="tab-{{ tab.id }}" aria-controls="panel-{{ tab.id }}">
        {{ tab.label }}
        <span x-show="isActive({{ loop.index0 }})" class="absolute inset-block-end-0 inset-inline-0 h-0.5 rounded-full bg-primary-600"></span>
      </button>
    {% endfor %}
  </div>

  <div class="p-5 md:p-6">
    {# Description #}
    <div x-show="isActive(0)" id="panel-description" role="tabpanel" aria-labelledby="tab-description"
         class="prose prose-sm max-w-prose text-content-muted">
      {{ product.description|raw|default(trans('product.no_description')|default('لا يوجد وصف.')) }}
    </div>

    {# Specs #}
    <div x-show="isActive(1)" id="panel-specs" role="tabpanel" aria-labelledby="tab-specs" x-cloak>
      <table class="rkn-table">
        <tbody>
          {% for spec in product.specifications|default([]) %}
            <tr><th scope="row" class="w-1/3">{{ spec.name }}</th><td>{{ spec.value }}</td></tr>
          {% else %}
            <tr><td class="text-content-subtle">{{ trans('product.no_specs')|default('لا توجد مواصفات.') }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {# Reviews #}
    <div x-show="isActive(2)" id="panel-reviews" role="tabpanel" aria-labelledby="tab-reviews" x-cloak>
      {% include 'components/reviews/review-summary.twig' with { product: product } only %}
      {% include 'components/reviews/review-list.twig' with { product: product } only %}
    </div>
  </div>
</div>
