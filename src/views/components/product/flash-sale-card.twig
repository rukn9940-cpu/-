{#
  product/flash-sale-card.twig — time-boxed deal card with live countdown
  @param product  object  required
  @param endsAt   string  ISO datetime or epoch ms for the deal end
  @a11y  countdown values announced politely; progress bar is decorative
#}
{% set p = product %}
{% set image = p.image.url|default(p.image)|default(p.thumbnail) %}
{% set discount = p.sale_percentage|default(p.discount_percentage)|default(0) %}
{% set sold = p.sold_percentage|default(60) %}
<article class="rkn-card group relative flex flex-col overflow-hidden">
  <div class="absolute inset-block-start-0 inset-inline-0 z-10 flex items-center justify-between bg-gradient-to-r from-danger-600 to-secondary-500 px-3 py-1.5 text-xs font-bold text-white">
    <span class="inline-flex items-center gap-1">
      <svg class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4 14h6l-1 8 9-12h-6z"/></svg>
      {{ trans('product.flash_sale')|default('عرض سريع') }}
    </span>
    {% if discount %}<span>-{{ discount }}%</span>{% endif %}
  </div>

  <a href="{{ p.url }}" class="relative block aspect-square overflow-hidden bg-surface-sunken pt-7">
    <img src="{{ image }}" alt="{{ p.name }}" loading="lazy" width="400" height="400"
         class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
  </a>

  <div class="flex flex-1 flex-col p-4">
    <h3 class="line-clamp-2 text-sm font-semibold text-content"><a href="{{ p.url }}" class="hover:text-primary-700">{{ p.name }}</a></h3>

    <div class="mt-3 flex items-baseline gap-2">
      <span class="text-lg font-extrabold text-danger-600">{{ (p.sale_price|default(p.price))|money }}</span>
      {% if p.regular_price %}<span class="text-sm text-content-subtle line-through">{{ p.regular_price|money }}</span>{% endif %}
    </div>

    {# Stock progress #}
    <div class="mt-3">
      <div class="h-2 w-full overflow-hidden rounded-full bg-surface-sunken" role="presentation">
        <div class="h-full rounded-full bg-gradient-to-r from-secondary-500 to-danger-500" style="inline-size: {{ sold }}%"></div>
      </div>
      <p class="mt-1 text-xs text-content-muted">{{ trans('product.sold')|default('تم بيع') }} {{ sold }}%</p>
    </div>

    {# Countdown #}
    <div class="mt-3 grid grid-cols-4 gap-1.5 text-center" x-data="rknCountdown('{{ endsAt }}')" aria-live="polite">
      {% for unit in ['days','hours','minutes','seconds'] %}
        <div class="rounded-lg bg-accent py-1.5 text-content-inverse">
          <span class="block text-base font-extrabold tabular-nums" x-text="{{ unit }}">00</span>
          <span class="block text-[10px] opacity-70">{{ trans('time.' ~ unit)|default(unit) }}</span>
        </div>
      {% endfor %}
    </div>

    <div class="mt-4">
      <salla-add-product-button product-id="{{ p.id }}" class="rkn-btn rkn-btn--danger rkn-btn--block">{{ trans('cart.add_to_cart') }}</salla-add-product-button>
    </div>
  </div>
</article>
