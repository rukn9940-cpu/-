{#
  product/product-info.twig — product purchase panel
  @summary  Brand, title, rating, price, stock, short description, quantity +
            add-to-cart, wishlist/compare, and trust badges.
  @param product  object  required
  @a11y  one <h1> for product name; stock state announced; actions labelled
#}
{% set p = product %}
{% set onSale = p.is_on_sale|default(false) or (p.sale_price is defined and p.sale_price) %}
<div class="flex flex-col gap-5" x-data="rknTrackView('{{ p.id }}')">
  {% if p.brand.name is defined %}
    <a href="{{ p.brand.url|default('#') }}" class="text-sm font-medium text-primary-600 hover:underline">{{ p.brand.name }}</a>
  {% endif %}

  <h1 class="text-2xl font-extrabold leading-tight text-content md:text-3xl">{{ p.name }}</h1>

  <div class="flex flex-wrap items-center gap-4">
    {% if p.rating.stars is defined or p.rating is defined %}
      {% include 'components/ui/rating-stars.twig' with { value: p.rating.stars|default(p.rating)|default(0), count: p.rating.count|default(p.reviews_count)|default(0), size: 'md' } only %}
    {% endif %}
    <span class="text-sm text-content-subtle">{{ trans('product.sku') }}: {{ p.sku|default('—') }}</span>
  </div>

  {# Price #}
  <div class="flex flex-wrap items-baseline gap-3">
    <span class="text-3xl font-extrabold text-content">{{ (p.sale_price|default(p.price))|money }}</span>
    {% if onSale and p.regular_price %}
      <span class="text-lg text-content-subtle line-through">{{ p.regular_price|money }}</span>
      {% if p.sale_percentage|default(p.discount_percentage) %}
        <span class="rkn-badge rkn-badge--sale">-{{ p.sale_percentage|default(p.discount_percentage) }}%</span>
      {% endif %}
    {% endif %}
  </div>

  {# Stock #}
  {% if p.is_out_of_stock|default(false) %}
    <p class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-danger-600"><span class="size-2 rounded-full bg-danger-500"></span>{{ trans('product.out_of_stock') }}</p>
  {% else %}
    <p class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-success-600"><span class="size-2 rounded-full bg-success-500"></span>{{ trans('product.in_stock') }}</p>
  {% endif %}

  {% if p.short_description %}
    <p class="text-sm leading-relaxed text-content-muted">{{ p.short_description }}</p>
  {% endif %}

  {# Options placeholder — Salla renders option inputs; styled by our tokens #}
  <salla-product-options product-id="{{ p.id }}"></salla-product-options>

  {# Purchase row #}
  {% if not p.is_out_of_stock|default(false) %}
    <div class="flex flex-wrap items-center gap-3">
      {% include 'components/ui/quantity-selector.twig' with { value: 1, max: p.max_quantity|default(99) } only %}
      <salla-add-product-button product-id="{{ p.id }}" class="rkn-btn rkn-btn--primary rkn-btn--lg flex-1">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.2"/><circle cx="18" cy="20" r="1.2"/></svg>
        {{ trans('cart.add_to_cart') }}
      </salla-add-product-button>
    </div>
  {% endif %}

  <div class="flex items-center gap-3">
    {% include 'components/commerce/wishlist-button.twig' with { product: p } only %}
    {% if theme.settings.show_compare|default(true) %}{% include 'components/commerce/compare-button.twig' with { product: p } only %}{% endif %}
    <span class="text-sm text-content-muted">{{ trans('product.add_to_wishlist') }}</span>
  </div>

  {% include 'components/trust/trust-badges.twig' with { layout: 'inline' } only %}
</div>
