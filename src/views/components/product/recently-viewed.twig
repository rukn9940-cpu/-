{#
  product/recently-viewed.twig — recently viewed products strip
  @summary  Reads the persisted recently-viewed store (client ids). Renders the
            Salla products slider as the data source; hides itself when empty.
  @param title  string  default 'شوهدت مؤخرًا'
  @a11y  region label; hidden entirely when there is nothing to show
#}
<section class="rkn-section" x-data x-show="$store.recentlyViewed.count > 0" x-cloak
         aria-label="{{ title|default(trans('product.recently_viewed')|default('شوهدت مؤخرًا')) }}">
  <div class="rkn-container">
    <h2 class="mb-6 text-xl font-bold text-content md:text-2xl">{{ title|default(trans('product.recently_viewed')|default('شوهدت مؤخرًا')) }}</h2>
    {# Salla's slider keeps the data fresh; our tokens style the surrounding chrome. #}
    <salla-products-slider source="latest-viewed" :source-value="$store.recentlyViewed.items"></salla-products-slider>
  </div>
</section>
