{#
  product/product-card.twig — premium product card
  @summary  Media with labels + hover quick-actions (wishlist/compare), brand,
            title, rating, price (with old price + discount), and add-to-cart.
  @param product   object  required — Salla product
  @param size      string  md|lg (default md)
  @param showRating bool   default true
  @param showActions bool  show wishlist/compare overlay (default true)
  @a11y  whole card title is the primary link; actions are separately labelled
#}
{% set p = product %}
{% set onSale = p.is_on_sale|default(false) or (p.sale_price is defined and p.sale_price) %}
{% set image = p.image.url|default(p.image)|default(p.thumbnail) %}
{% set hover = p.images[1].url|default(p.images[1])|default(null) %}
<article class="rkn-card rkn-card--interactive group relative flex flex-col overflow-hidden">
  {# Media #}
  <a href="{{ p.url }}" class="relative block aspect-square overflow-hidden bg-surface-sunken" aria-label="{{ p.name }}">
    {% include 'components/ui/product-label.twig' with { product: p } only %}
    <img src="{{ image }}" alt="{{ p.name }}" loading="lazy" width="400" height="400"
         class="h-full w-full object-cover transition duration-500 group-hover:scale-105 {{ hover ? 'group-hover:opacity-0' : '' }}">
    {% if hover %}
      <img src="{{ hover }}" alt="" aria-hidden="true" loading="lazy" width="400" height="400"
           class="absolute inset-0 h-full w-full object-cover opacity-0 transition duration-500 group-hover:opacity-100">
    {% endif %}
  </a>

  {# Quick actions #}
  {% if showActions|default(true) %}
    <div class="absolute inset-block-start-3 inset-inline-end-3 z-10 flex flex-col gap-2 opacity-0 transition duration-300 group-hover:opacity-100 focus-within:opacity-100">
      {% include 'components/commerce/wishlist-button.twig' with { product: p, size: 'sm' } only %}
      {% if theme.settings.show_compare|default(true) %}
        {% include 'components/commerce/compare-button.twig' with { product: p, size: 'sm' } only %}
      {% endif %}
    </div>
  {% endif %}

  {# Body #}
  <div class="flex flex-1 flex-col p-4">
    {% if p.brand.name is defined %}
      <span class="mb-1 text-xs font-medium text-content-subtle">{{ p.brand.name }}</span>
    {% endif %}

    <h3 class="line-clamp-2 text-sm font-semibold leading-snug text-content">
      <a href="{{ p.url }}" class="text-content before:absolute before:inset-0 hover:text-primary-700">{{ p.name }}</a>
    </h3>

    {% if showRating|default(true) and (p.rating.stars is defined or p.rating is defined) %}
      <div class="mt-2">
        {% include 'components/ui/rating-stars.twig' with { value: p.rating.stars|default(p.rating)|default(0), count: p.rating.count|default(p.reviews_count)|default(null) } only %}
      </div>
    {% endif %}

    {# Price #}
    <div class="mt-3 flex items-baseline gap-2">
      <span class="text-base font-extrabold text-content">{{ (p.sale_price|default(p.price))|money }}</span>
      {% if onSale and p.regular_price %}
        <span class="text-sm text-content-subtle line-through">{{ p.regular_price|money }}</span>
      {% endif %}
    </div>

    {# Add to cart #}
    <div class="relative z-10 mt-4">
      {% if p.is_out_of_stock|default(false) %}
        <button class="rkn-btn rkn-btn--outline rkn-btn--block" disabled>{{ trans('product.out_of_stock') }}</button>
      {% else %}
        <salla-add-product-button product-id="{{ p.id }}" class="rkn-btn rkn-btn--primary rkn-btn--block">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.2"/><circle cx="18" cy="20" r="1.2"/></svg>
          {{ trans('cart.add_to_cart') }}
        </salla-add-product-button>
      {% endif %}
    </div>
  </div>
</article>
