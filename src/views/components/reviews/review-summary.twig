{#
  reviews/review-summary.twig — aggregate rating summary
  @summary  Average score, star display, total count, and a 5→1 distribution.
            Provider-agnostic: consumes a normalized `rating` shape so the
            source (Salla native now, Google later) can change without edits.
  @param product  object  required — rating: { average, count, breakdown:{5,4,3,2,1} }
#}
{% set r = product.rating|default({}) %}
{% set avg = r.average|default(r.stars)|default(0) %}
{% set count = r.count|default(product.reviews_count)|default(0) %}
{% set breakdown = r.breakdown|default({}) %}
<div class="grid gap-6 rounded-xl border border-border bg-surface-sunken p-5 md:grid-cols-[auto_1fr]">
  <div class="flex flex-col items-center justify-center text-center md:px-6">
    <span class="text-4xl font-extrabold text-content">{{ avg }}</span>
    {% include 'components/ui/rating-stars.twig' with { value: avg, size: 'md' } only %}
    <span class="mt-1 text-xs text-content-subtle">{{ count }} {{ trans('product.reviews') }}</span>
  </div>

  <div class="flex flex-col justify-center gap-1.5">
    {% for star in [5,4,3,2,1] %}
      {% set pct = count > 0 ? ((breakdown[star]|default(0)) / count * 100)|round : 0 %}
      <div class="flex items-center gap-2 text-xs">
        <span class="w-8 text-content-muted">{{ star }} ★</span>
        <div class="h-2 flex-1 overflow-hidden rounded-full bg-border">
          <div class="h-full rounded-full bg-secondary-500" style="inline-size: {{ pct }}%"></div>
        </div>
        <span class="w-9 text-end text-content-subtle">{{ breakdown[star]|default(0) }}</span>
      </div>
    {% endfor %}
  </div>
</div>
