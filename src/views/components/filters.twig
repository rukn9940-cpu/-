{% set groups = groups|default([]) %}
<div x-data="rknFilters">
  <button class="rkn-btn rkn-btn--outline rkn-btn--sm lg:hidden" @click="openDrawer()" :aria-expanded="drawer">
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 5h18M6 12h12M10 19h4"/></svg>
    {{ trans('category.filters')|default('الفلاتر') }}
    <span x-show="applied > 0" x-cloak class="rkn-badge rkn-badge--primary" x-text="applied"></span>
  </button>

  <div class="rkn-overlay lg:hidden" x-show="drawer" x-cloak x-transition.opacity @click="closeDrawer()"></div>

  <aside class="fixed inset-block-0 inset-inline-start-0 z-drawer w-[86%] max-w-sm overflow-y-auto bg-surface p-5 shadow-2xl lg:static lg:block lg:w-auto lg:max-w-none lg:bg-transparent lg:p-0 lg:shadow-none"
         x-show="drawer || window.matchMedia('(min-width:1024px)').matches"
         x-transition:enter="transition ease-emphasized duration-300" x-transition:enter-start="-translate-x-full rtl:translate-x-full" x-transition:enter-end="translate-x-0"
         role="dialog" aria-label="{{ trans('category.filters')|default('الفلاتر') }}" @change="count()">
    <div class="mb-4 flex items-center justify-between lg:mb-2">
      <h2 class="text-base font-bold">{{ trans('category.filters')|default('الفلاتر') }}</h2>
      <div class="flex items-center gap-2">
        <button class="text-sm text-primary-600 hover:underline" @click="reset()">{{ trans('category.reset')|default('إعادة تعيين') }}</button>
        <button class="rkn-btn rkn-btn--ghost rkn-btn--icon lg:hidden" @click="closeDrawer()" aria-label="{{ trans('common.close')|default('إغلاق') }}"><svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l8 8M14 6l-8 8"/></svg></button>
      </div>
    </div>

    <form method="get">
      {% for group in groups %}
        <fieldset class="border-t border-border py-4">
          <legend class="contents">
            <button type="button" class="flex w-full items-center justify-between text-sm font-semibold text-content" @click="toggleGroup('{{ group.id }}')" :aria-expanded="!isCollapsed('{{ group.id }}')">
              {{ group.title }}
              <svg class="size-4 transition" :class="isCollapsed('{{ group.id }}') && 'rotate-180'" viewBox="0 0 20 20" fill="currentColor"><path d="M5 12l5-5 5 5z"/></svg>
            </button>
          </legend>
          <div x-show="!isCollapsed('{{ group.id }}')" x-collapse class="mt-3 space-y-2">
            {% if group.type == 'price' %}
              <div class="flex items-center gap-2">
                <input type="number" name="price_min" class="rkn-input" placeholder="{{ trans('category.min')|default('من') }}">
                <span class="text-content-subtle">—</span>
                <input type="number" name="price_max" class="rkn-input" placeholder="{{ trans('category.max')|default('إلى') }}">
              </div>
            {% else %}
              {% for opt in group.options|default([]) %}
                <label class="flex cursor-pointer items-center gap-2.5 text-sm text-content-muted hover:text-content">
                  <input type="checkbox" name="{{ group.id }}[]" value="{{ opt.value }}" class="size-4 rounded border-border text-primary-600 focus:ring-primary-500">
                  <span class="flex-1">{{ opt.label }}</span>
                  {% if opt.count is defined %}<span class="text-xs text-content-subtle">{{ opt.count }}</span>{% endif %}
                </label>
              {% endfor %}
            {% endif %}
          </div>
        </fieldset>
      {% endfor %}
      <div class="sticky inset-block-end-0 mt-4 bg-surface pt-3 lg:static lg:mt-2">
        <button type="submit" class="rkn-btn rkn-btn--primary rkn-btn--block">{{ trans('category.apply')|default('تطبيق') }}</button>
      </div>
    </form>
  </aside>
</div>
