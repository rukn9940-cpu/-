{% set images = product.images|default([{ url: product.image.url|default(product.image) }]) %}
<div class="flex flex-col-reverse gap-3 md:flex-row" x-data='rknGallery({{ images|json_encode|raw }})' @keydown.window="onKey($event)">
  <div class="flex gap-2 overflow-x-auto no-scrollbar md:flex-col" role="tablist" aria-label="{{ trans('product.gallery')|default('صور المنتج') }}">
    <template x-for="(img, i) in images" :key="i">
      <button type="button" class="relative size-16 shrink-0 overflow-hidden rounded-lg border-2 transition md:size-20" :class="active === i ? 'border-primary-500' : 'border-border hover:border-border-strong'" @click="select(i)" :aria-selected="active === i" role="tab" :aria-label="`{{ trans('product.image')|default('صورة') }} ${i + 1}`">
        <img :src="img.url || img" alt="" class="h-full w-full object-cover" loading="lazy">
      </button>
    </template>
  </div>
  <div class="relative flex-1 overflow-hidden rounded-xl border border-border bg-surface-sunken">
    <div class="aspect-square cursor-zoom-in" @click="zoom = !zoom">
      <template x-for="(img, i) in images" :key="i">
        <img x-show="active === i" :src="img.url || img" :alt="img.alt || '{{ product.name }}'" class="h-full w-full object-contain transition duration-300" :class="zoom && 'scale-150'" width="700" height="700" :loading="i === 0 ? 'eager' : 'lazy'" :fetchpriority="i === 0 ? 'high' : 'auto'">
      </template>
    </div>
    <button type="button" class="absolute inset-block-1/2 inset-inline-start-3 grid size-10 -translate-y-1/2 place-items-center rounded-full bg-surface/90 text-content shadow-md backdrop-blur transition hover:bg-surface" @click="prev()" aria-label="{{ trans('common.previous')|default('السابق') }}"><svg class="size-5 rkn-flip-rtl" viewBox="0 0 20 20" fill="currentColor"><path d="M12.5 4l-6 6 6 6 1.4-1.4L9.3 10l4.6-4.6z"/></svg></button>
    <button type="button" class="absolute inset-block-1/2 inset-inline-end-3 grid size-10 -translate-y-1/2 place-items-center rounded-full bg-surface/90 text-content shadow-md backdrop-blur transition hover:bg-surface" @click="next()" aria-label="{{ trans('common.next')|default('التالي') }}"><svg class="size-5 rkn-flip-rtl" viewBox="0 0 20 20" fill="currentColor"><path d="M7.5 4L6.1 5.4 10.7 10l-4.6 4.6L7.5 16l6-6z"/></svg></button>
  </div>
</div>
