{#
  footer/newsletter.twig — email subscription block
  @summary  Posts via the Salla newsletter SDK; inline success/error feedback.
  @a11y  labelled input, aria-live status, descriptive submit state
#}
<div class="rounded-2xl bg-accent p-6 text-content-inverse md:p-8"
     x-data="{ email: '', state: 'idle', msg: '' }">
  <div class="grid items-center gap-6 md:grid-cols-2">
    <div>
      <h2 class="text-xl font-bold md:text-2xl">{{ trans('footer.newsletter_title') }}</h2>
      <p class="mt-2 text-sm text-content-inverse/75">{{ trans('footer.newsletter_subtitle')|default('أحدث العروض والمنتجات في بريدك.') }}</p>
    </div>
    <form class="flex flex-col gap-2 sm:flex-row" @submit.prevent="
        state = 'loading';
        (window.salla?.newsletter?.subscribe?.({ email }) ?? Promise.reject())
          .then(() => { state = 'success'; msg = '{{ trans('footer.subscribed')|default('تم الاشتراك بنجاح!') }}'; email=''; })
          .catch(() => { state = 'error'; msg = '{{ trans('common.error_generic') }}'; })">
      <label for="rkn-newsletter" class="sr-only">{{ trans('footer.newsletter_placeholder') }}</label>
      <input id="rkn-newsletter" type="email" required x-model="email"
             class="rkn-input h-12 flex-1 border-transparent text-content"
             placeholder="{{ trans('footer.newsletter_placeholder') }}">
      <button type="submit" class="rkn-btn rkn-btn--secondary rkn-btn--lg" :disabled="state === 'loading'">
        <span x-show="state !== 'loading'">{{ trans('footer.subscribe') }}</span>
        <span x-show="state === 'loading'" x-cloak>{{ trans('common.loading') }}</span>
      </button>
    </form>
  </div>
  <p x-show="msg" x-cloak aria-live="polite" class="mt-3 text-sm"
     :class="state === 'success' ? 'text-success-500' : 'text-danger-500'" x-text="msg"></p>
</div>
