{#
  trust/trust-badges.twig — trust signals (critical for security retailing)
  @param layout  string  strip|inline|grid (default strip)
  @param items   array   optional override of [{ icon, title, text }]
  @a11y  list semantics; icons decorative
#}
{% set items = items|default([
  { icon: 'shield', title: trans('trust.warranty'), text: trans('trust.warranty_text')|default('ضمان رسمي على جميع المنتجات') },
  { icon: 'badge-check', title: trans('trust.authentic'), text: trans('trust.authentic_text')|default('منتجات أصلية 100%') },
  { icon: 'lock', title: trans('trust.secure_checkout'), text: trans('trust.secure_text')|default('دفع آمن ومشفّر') },
  { icon: 'tool', title: trans('trust.installation_available'), text: trans('trust.installation_text')|default('تركيب احترافي معتمد') }
]) %}
{% set layout = layout|default('strip') %}

{% if layout == 'inline' %}
  <ul class="grid grid-cols-2 gap-3 rounded-xl border border-border bg-surface-sunken p-4">
    {% for it in items %}
      <li class="flex items-center gap-2.5">
        <svg class="size-6 shrink-0 text-primary-600" aria-hidden="true"><use href="#icon-{{ it.icon }}"></use></svg>
        <span class="text-xs font-semibold text-content">{{ it.title }}</span>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <ul class="grid grid-cols-2 gap-4 md:grid-cols-4 {{ layout == 'grid' ? '' : 'rkn-container' }}">
    {% for it in items %}
      <li class="flex flex-col items-center gap-2 rounded-xl border border-border bg-surface p-5 text-center">
        <span class="grid size-12 place-items-center rounded-full bg-primary-50 text-primary-600">
          <svg class="size-6" aria-hidden="true"><use href="#icon-{{ it.icon }}"></use></svg>
        </span>
        <span class="text-sm font-bold text-content">{{ it.title }}</span>
        <span class="text-xs text-content-muted">{{ it.text }}</span>
      </li>
    {% endfor %}
  </ul>
{% endif %}
