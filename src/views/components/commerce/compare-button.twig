{#
  commerce/compare-button.twig — toggle a product in the persisted compare list
  @param product  object  required
  @param size     string  sm|md (default md)
  @a11y  aria-pressed reflects compare state; label changes accordingly
#}
{% set sz = (size|default('md') == 'sm') ? 'size-9' : 'size-10' %}
<button type="button" x-data
  class="grid {{ sz }} place-items-center rounded-full border bg-surface/90 shadow-sm backdrop-blur transition"
  :class="$store.compare.has('{{ product.id }}') ? 'border-primary-300 text-primary-600' : 'border-border text-content-muted hover:text-primary-600'"
  @click="$store.compare.toggle('{{ product.id }}')"
  :aria-pressed="$store.compare.has('{{ product.id }}')"
  aria-label="{{ trans('product.compare') }}">
  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3v18M17 3v18M3 8h8M13 16h8"/></svg>
</button>
