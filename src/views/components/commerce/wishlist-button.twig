{#
  commerce/wishlist-button.twig — toggle wishlist via Salla web component
  @param product  object  required
  @param size     string  sm|md (default md)
  @a11y  uses Salla's <salla-wishlist> which manages aria-pressed + sync
#}
{% set sz = (size|default('md') == 'sm') ? 'size-9' : 'size-10' %}
<salla-wishlist product-id="{{ product.id }}"
  class="grid {{ sz }} place-items-center rounded-full border border-border bg-surface/90 text-content-muted shadow-sm backdrop-blur transition hover:text-danger-600 hover:border-danger-200"
  aria-label="{{ trans('product.add_to_wishlist') }}">
  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
    <path d="M12 20s-7-4.6-9.2-8.4C1 8.4 2.7 5 6 5c2 0 3.2 1.2 4 2.3C10.8 6.2 12 5 14 5c3.3 0 5 3.4 3.2 6.6C19 15.4 12 20 12 20z"/>
  </svg>
</salla-wishlist>
