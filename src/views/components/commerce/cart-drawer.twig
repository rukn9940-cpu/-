{#
  commerce/cart-drawer.twig — slide-in mini cart
  @summary  Opens on add-to-cart (SDK event) or the rkn:open-cart DOM event.
            Reads cart truth from the Salla SDK web components; the drawer only
            controls visibility and item removal requests.
  @a11y  dialog with focus trap; Esc + overlay close; live region for totals
#}
<div x-data="rknCartDrawer()" @keydown.escape.window="hide()">
  {# Overlay #}
  <div class="rkn-overlay" x-show="open" x-cloak x-transition.opacity @click="hide()"></div>

  {# Panel slides from inline-end #}
  <aside class="fixed inset-block-0 inset-inline-end-0 z-drawer flex w-[92%] max-w-md flex-col bg-surface shadow-2xl"
         x-show="open" x-cloak
         x-transition:enter="transition ease-emphasized duration-300"
         x-transition:enter-start="translate-x-full rtl:-translate-x-full" x-transition:enter-end="translate-x-0"
         x-transition:leave="transition ease-exit duration-200"
         x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full rtl:-translate-x-full"
         x-trap.noscroll="open" role="dialog" aria-modal="true" aria-label="{{ trans('cart.title') }}">

    <header class="flex items-center justify-between border-b border-border p-4">
      <h2 class="flex items-center gap-2 text-base font-bold">
        {{ trans('cart.title') }}
        <span class="rkn-badge rkn-badge--primary" x-text="$store.badges.cart" x-show="$store.badges.cart > 0"></span>
      </h2>
      <button class="rkn-btn rkn-btn--ghost rkn-btn--icon" @click="hide()" aria-label="{{ trans('common.close') }}">
        <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l8 8M14 6l-8 8"/></svg>
      </button>
    </header>

    {# Items (Salla renders live cart items here) #}
    <div class="flex-1 overflow-y-auto p-4" aria-live="polite">
      <template x-if="$store.badges.cart === 0">
        <div>
          {% include 'components/ui/empty-state.twig' with {
            icon: 'cart',
            title: trans('cart.empty'),
            ctaLabel: trans('common.start_shopping')|default('ابدأ التسوق'),
            ctaHref: '/'
          } only %}
        </div>
      </template>
      <salla-cart-summary x-show="$store.badges.cart > 0"></salla-cart-summary>
    </div>

    {# Footer #}
    <footer class="border-t border-border p-4" x-show="$store.badges.cart > 0" x-cloak>
      <a href="{{ url.cart|default('/cart') }}" class="rkn-btn rkn-btn--outline rkn-btn--block mb-2">{{ trans('cart.title') }}</a>
      <a href="{{ url.checkout|default('/checkout') }}" class="rkn-btn rkn-btn--primary rkn-btn--block rkn-btn--lg">{{ trans('cart.checkout') }}</a>
    </footer>
  </aside>
</div>
