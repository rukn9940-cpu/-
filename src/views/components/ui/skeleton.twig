{#
  ui/skeleton.twig — loading placeholders (CLS-safe, RTL-aware shimmer)
  @param variant  string  product-card|line|media|text|avatar|category-card (default line)
  @param count    number  how many to render (default 1)
  @a11y  aria-hidden; pair with an aria-live status elsewhere
#}
{% set variant = variant|default('line') %}
{% for _ in 1..(count|default(1)) %}
  {% if variant == 'product-card' %}
    <div class="rkn-card overflow-hidden" aria-hidden="true">
      <div class="rkn-skeleton aspect-square w-full"></div>
      <div class="rkn-card__body space-y-3">
        <div class="rkn-skeleton h-3 w-1/3"></div>
        <div class="rkn-skeleton h-4 w-4/5"></div>
        <div class="rkn-skeleton h-5 w-1/2"></div>
        <div class="rkn-skeleton h-9 w-full rounded-lg"></div>
      </div>
    </div>
  {% elseif variant == 'category-card' %}
    <div class="rkn-skeleton aspect-[4/3] w-full rounded-xl" aria-hidden="true"></div>
  {% elseif variant == 'media' %}
    <div class="rkn-skeleton aspect-video w-full rounded-xl" aria-hidden="true"></div>
  {% elseif variant == 'avatar' %}
    <div class="rkn-skeleton size-12 rounded-full" aria-hidden="true"></div>
  {% elseif variant == 'text' %}
    <div class="space-y-2" aria-hidden="true">
      <div class="rkn-skeleton h-3 w-full"></div>
      <div class="rkn-skeleton h-3 w-11/12"></div>
      <div class="rkn-skeleton h-3 w-2/3"></div>
    </div>
  {% else %}
    <div class="rkn-skeleton h-4 w-full" aria-hidden="true"></div>
  {% endif %}
{% endfor %}
