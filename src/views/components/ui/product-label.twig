{#
  ui/product-label.twig — corner labels overlaid on product media
  @summary  Renders sale %, "new", "best seller", stock state, and custom Salla
            labels as stacked corner ribbons. Pair with product-card.
  @param product  object  required — Salla product object
  @a11y  decorative position; meaning is also conveyed in text elsewhere
#}
{% set discount = product.sale_percentage|default(product.discount_percentage)|default(0) %}
<div class="pointer-events-none absolute inset-block-start-3 inset-inline-start-3 z-10 flex flex-col items-start gap-1.5">
  {% if discount > 0 %}
    <span class="rkn-badge rkn-badge--sale shadow-sm">-{{ discount }}%</span>
  {% endif %}

  {% if product.is_new|default(false) %}
    <span class="rkn-badge rkn-badge--primary shadow-sm">{{ trans('product.new')|default('جديد') }}</span>
  {% endif %}

  {% if product.is_out_of_stock|default(false) %}
    <span class="rkn-badge rkn-badge--neutral shadow-sm">{{ trans('product.out_of_stock') }}</span>
  {% endif %}

  {# Custom labels coming from Salla product data #}
  {% for label in product.labels|default([]) %}
    <span class="rkn-badge shadow-sm"
          style="background-color: {{ label.color|default('#0F172A') }}; color:#fff;">
      {{ label.name|default(label) }}
    </span>
  {% endfor %}
</div>
