{#
  ui/error-state.twig — error / failure placeholder
  @param code     string  optional status code (e.g. 404, 500)
  @param title    string  required
  @param message  string  optional
  @param ctaLabel string  optional (default: back home)
  @param ctaHref  string  optional
  @a11y  role=alert so assistive tech announces the failure
#}
<div class="mx-auto flex max-w-md flex-col items-center px-4 py-16 text-center" role="alert">
  {% if code %}
    <p class="text-6xl font-extrabold tracking-tight text-primary-600">{{ code }}</p>
  {% else %}
    <div class="mb-5 flex size-20 items-center justify-center rounded-full bg-danger-50 text-danger-600">
      <svg class="size-9" aria-hidden="true"><use href="#icon-alert"></use></svg>
    </div>
  {% endif %}
  <h1 class="mt-3 text-xl font-bold text-content">{{ title }}</h1>
  {% if message %}<p class="mt-2 text-sm text-content-muted">{{ message }}</p>{% endif %}
  <a href="{{ ctaHref|default('/') }}" class="rkn-btn rkn-btn--primary mt-6">
    {{ ctaLabel|default(trans('common.back_home')|default('العودة للرئيسية')) }}
  </a>
</div>
