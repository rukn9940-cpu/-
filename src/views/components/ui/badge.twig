{#
  ui/badge.twig — small status pill
  @param text     string  required
  @param variant  string  primary|success|warning|danger|neutral|sale (default neutral)
  @param icon     string  optional icon name
#}
<span class="rkn-badge rkn-badge--{{ variant|default('neutral') }}">
  {% if icon %}<svg class="size-3.5" aria-hidden="true"><use href="#icon-{{ icon }}"></use></svg>{% endif %}
  {{ text }}
</span>
