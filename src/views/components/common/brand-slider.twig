{#
  common/brand-slider.twig — brand logos carousel
  @param brands  array  [{ name, logo, url }]
  @param title   string optional heading
  @a11y  region label; logos have brand-name alt; RTL-aware scroll
#}
{% set brands = brands|default([]) %}
{% if brands is not empty %}
<section class="rkn-section" aria-label="{{ title|default(trans('nav.brands')) }}"
         x-data="rknCarousel({ autoplay: 0 })">
  <div class="rkn-container">
    {% if title %}<h2 class="mb-6 text-xl font-bold text-content md:text-2xl">{{ title }}</h2>{% endif %}
    <div x-ref="track" class="rkn-carousel__track items-center">
      {% for brand in brands %}
        <a href="{{ brand.url|default('#') }}" class="flex h-20 w-36 shrink-0 items-center justify-center rounded-xl border border-border bg-surface p-4 grayscale transition hover:grayscale-0 hover:shadow-md">
          <img src="{{ brand.logo }}" alt="{{ brand.name }}" loading="lazy" class="max-h-12 w-auto object-contain">
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
