{#
  common/faq.twig — accessible FAQ accordion
  @param items   array  [{ q, a }]
  @param title   string optional heading
  @param jsonld  bool   emit FAQPage structured data (default true)
  @a11y  button-controlled disclosure; aria-expanded + aria-controls
  @seo   optional FAQPage JSON-LD
#}
{% set items = items|default([]) %}
{% if items is not empty %}
<div x-data="{ open: 0 }">
  {% if title %}<h2 class="mb-6 text-xl font-extrabold text-content md:text-2xl">{{ title }}</h2>{% endif %}
  <div class="divide-y divide-border overflow-hidden rounded-xl border border-border bg-surface">
    {% for item in items %}
      <div>
        <h3>
          <button type="button" class="flex w-full items-center justify-between gap-4 p-4 text-start text-sm font-semibold text-content transition hover:bg-surface-sunken md:text-base"
                  @click="open = (open === {{ loop.index0 }} ? null : {{ loop.index0 }})"
                  :aria-expanded="open === {{ loop.index0 }}" aria-controls="faq-{{ loop.index0 }}">
            {{ item.q }}
            <svg class="size-5 shrink-0 text-primary-600 transition" :class="open === {{ loop.index0 }} && 'rotate-180'" viewBox="0 0 20 20" fill="currentColor"><path d="M5 7l5 5 5-5z"/></svg>
          </button>
        </h3>
        <div id="faq-{{ loop.index0 }}" x-show="open === {{ loop.index0 }}" x-collapse>
          <div class="px-4 pb-4 text-sm leading-relaxed text-content-muted">{{ item.a }}</div>
        </div>
      </div>
    {% endfor %}
  </div>

  {% if jsonld|default(true) %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for item in items %}
        {
          "@type": "Question",
          "name": {{ item.q|json_encode|raw }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ item.a|json_encode|raw }} }
        }{{ not loop.last ? ',' : '' }}
        {% endfor %}
      ]
    }
    </script>
  {% endif %}
</div>
{% endif %}
