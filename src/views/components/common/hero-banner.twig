{#
  common/hero-banner.twig — single premium hero banner
  @param title     string  required
  @param subtitle  string  optional
  @param image     string  background image url
  @param ctaLabel  string  optional
  @param ctaHref   string  optional
  @param align     string  start|center (default start)
  @a11y  one prominent heading; image has empty alt (decorative bg)
#}
<section class="relative overflow-hidden rounded-2xl bg-accent text-content-inverse">
  {% if image %}
    <img src="{{ image }}" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-60" loading="eager" fetchpriority="high">
    <span class="absolute inset-0 bg-gradient-to-r from-slate-950/85 via-slate-950/50 to-transparent"></span>
  {% endif %}
  <div class="relative rkn-container flex min-h-[340px] flex-col justify-center py-12 md:min-h-[440px] {{ align|default('start') == 'center' ? 'items-center text-center' : 'items-start' }}">
    <div class="max-w-xl {{ align|default('start') == 'center' ? 'mx-auto' : '' }}">
      <h1 class="text-3xl font-extrabold leading-tight md:text-5xl">{{ title }}</h1>
      {% if subtitle %}<p class="mt-4 text-base text-content-inverse/80 md:text-lg">{{ subtitle }}</p>{% endif %}
      {% if ctaLabel and ctaHref %}
        <a href="{{ ctaHref }}" class="rkn-btn rkn-btn--primary rkn-btn--lg mt-7">{{ ctaLabel }}</a>
      {% endif %}
    </div>
  </div>
</section>
