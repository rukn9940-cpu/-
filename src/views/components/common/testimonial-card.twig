{#
  common/testimonial-card.twig — customer testimonial
  @param testimonial  object  { author, role, avatar, rating, body }
#}
{% set t = testimonial %}
<figure class="rkn-card flex h-full flex-col p-5">
  {% if t.rating is defined %}
    <div class="mb-3">{% include 'components/ui/rating-stars.twig' with { value: t.rating } only %}</div>
  {% endif %}
  <blockquote class="flex-1 text-sm leading-relaxed text-content-muted">“{{ t.body }}”</blockquote>
  <figcaption class="mt-4 flex items-center gap-3 border-t border-border pt-4">
    {% if t.avatar %}
      <img src="{{ t.avatar }}" alt="{{ t.author }}" class="size-10 rounded-full object-cover" loading="lazy">
    {% else %}
      <span class="grid size-10 place-items-center rounded-full bg-primary-50 text-sm font-bold text-primary-700">{{ t.author|slice(0,1)|upper }}</span>
    {% endif %}
    <div>
      <p class="text-sm font-semibold text-content">{{ t.author }}</p>
      {% if t.role %}<p class="text-xs text-content-subtle">{{ t.role }}</p>{% endif %}
    </div>
  </figcaption>
</figure>
