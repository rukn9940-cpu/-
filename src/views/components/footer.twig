{% set columns = columns|default(store.menus.footer)|default([]) %}
{% set socials = store.social|default([]) %}

<div class="mt-16 border-t border-border bg-surface">
  <div class="rkn-container py-12">

    {# Newsletter #}
    <div class="mb-12 rounded-2xl bg-accent p-6 text-content-inverse md:p-8" x-data="rknNewsletter">
      <div class="grid items-center gap-6 md:grid-cols-2">
        <div>
          <h2 class="text-xl font-bold md:text-2xl">{{ trans('footer.newsletter_title')|default('اشترك في النشرة البريدية') }}</h2>
          <p class="mt-2 text-sm text-content-inverse/75">{{ trans('footer.newsletter_subtitle')|default('أحدث العروض والمنتجات في بريدك.') }}</p>
        </div>
        <form class="flex flex-col gap-2 sm:flex-row" @submit.prevent="subscribe()">
          <label for="rkn-newsletter" class="sr-only">{{ trans('footer.newsletter_placeholder')|default('بريدك الإلكتروني') }}</label>
          <input id="rkn-newsletter" type="email" required x-model="email" class="rkn-input h-12 flex-1 border-transparent text-content" placeholder="{{ trans('footer.newsletter_placeholder')|default('بريدك الإلكتروني') }}">
          <button type="submit" class="rkn-btn rkn-btn--secondary rkn-btn--lg" :disabled="state === 'loading'">
            <span x-show="state !== 'loading'">{{ trans('footer.subscribe')|default('اشترك') }}</span>
            <span x-show="state === 'loading'" x-cloak>{{ trans('common.loading')|default('جارٍ…') }}</span>
          </button>
        </form>
      </div>
      <p x-show="msg" x-cloak aria-live="polite" class="mt-3 text-sm" :class="state === 'success' ? 'text-success-500' : 'text-danger-500'" x-text="msg"></p>
    </div>

    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <a href="{{ url.home|default('/') }}" class="inline-flex items-center gap-2">
          {% if store.logo %}<img src="{{ store.logo }}" alt="{{ store.name }}" class="h-9 w-auto">{% else %}<span class="text-xl font-extrabold text-content">{{ store.name|default('RKN') }}</span>{% endif %}
        </a>
        <p class="mt-4 max-w-sm text-sm text-content-muted">{{ store.description|default('متجرك المتخصص في أنظمة الأمن والمراقبة في المملكة العربية السعودية.') }}</p>
        <ul class="mt-5 space-y-2 text-sm text-content-muted">
          {% if store.phone %}<li class="flex items-center gap-2"><svg class="size-4 text-primary-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5c0 9 6 15 15 15l2-3-4-2-2 2c-3-1.5-5.5-4-7-7l2-2-2-4z"/></svg><a href="tel:{{ store.phone }}" dir="ltr">{{ store.phone }}</a></li>{% endif %}
          {% if store.email %}<li class="flex items-center gap-2"><svg class="size-4 text-primary-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><a href="mailto:{{ store.email }}">{{ store.email }}</a></li>{% endif %}
        </ul>
      </div>

      {% for col in columns %}
        <nav aria-label="{{ col.title|default(col.name) }}">
          <h3 class="mb-4 text-sm font-bold text-content">{{ col.title|default(col.name) }}</h3>
          <ul class="space-y-2.5">
            {% for link in col.children|default(col.items)|default([]) %}
              <li><a href="{{ link.url|default('#') }}" class="text-sm text-content-muted transition hover:text-primary-700">{{ link.title|default(link.name) }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      {% endfor %}
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-6 border-t border-border pt-8 md:flex-row">
      {% if socials is not empty %}
      <ul class="flex items-center gap-2">
        {% for s in socials %}
          <li><a href="{{ s.url }}" rel="noopener" target="_blank" class="grid size-10 place-items-center rounded-full border border-border text-content-muted transition hover:border-primary-300 hover:text-primary-600" aria-label="{{ s.name }}">
            <svg class="size-5" aria-hidden="true"><use href="#icon-{{ s.icon|default('link') }}"></use></svg>
          </a></li>
        {% endfor %}
      </ul>
      {% endif %}
      <div class="flex flex-wrap items-center gap-2 opacity-80">
        {% for pm in ['mada','visa','mastercard','applepay','tabby'] %}
          <span class="grid h-7 w-11 place-items-center rounded border border-border bg-surface text-[10px] font-bold text-content-subtle">{{ pm|upper }}</span>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="border-t border-border py-5 text-center text-xs text-content-subtle">
    © {{ "now"|date('Y') }} {{ store.name }} — {{ trans('footer.rights')|default('جميع الحقوق محفوظة') }}
  </div>
</div>

{# Bottom navigation (mobile) #}
<nav class="fixed inset-block-end-0 inset-inline-0 z-sticky border-t border-border bg-surface/95 backdrop-blur-md lg:hidden" style="padding-block-end: env(safe-area-inset-bottom)" aria-label="{{ trans('nav.bottom')|default('تنقل سفلي') }}" x-data>
  <ul class="grid grid-cols-5">
    <li><a href="{{ url.home|default('/') }}" class="flex flex-col items-center gap-1 py-2.5 text-[11px] text-content-muted"><svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 11l9-7 9 7M5 10v10h14V10"/></svg>{{ trans('nav.home')|default('الرئيسية') }}</a></li>
    <li><button @click="$store.ui.toggle('mobileNav')" class="flex w-full flex-col items-center gap-1 py-2.5 text-[11px] text-content-muted"><svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h16"/></svg>{{ trans('nav.categories')|default('الأقسام') }}</button></li>
    <li><button @click="$store.ui.toggle('search')" class="flex w-full flex-col items-center gap-1 py-2.5 text-[11px] text-content-muted"><svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M16 16l5 5"/></svg>{{ trans('common.search')|default('بحث') }}</button></li>
    <li><button @click="$dispatch('rkn:open-cart')" class="relative flex w-full flex-col items-center gap-1 py-2.5 text-[11px] text-content-muted"><svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg><span x-show="$store.badges.cart > 0" x-cloak x-text="$store.badges.cart" class="absolute inset-block-start-1 inset-inline-end-6 grid min-w-5 place-items-center rounded-full bg-primary-600 px-1 text-[10px] font-bold text-white"></span>{{ trans('cart.title')|default('السلة') }}</button></li>
    <li><a href="{{ user ? (url.get('profile')|default('/profile')) : (url.get('auth.login')|default('/login')) }}" class="flex flex-col items-center gap-1 py-2.5 text-[11px] text-content-muted"><svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>{{ trans('account.my_account')|default('حسابي') }}</a></li>
  </ul>
</nav>

{# Cart drawer #}
<div x-data="rknCartDrawer" @keydown.escape.window="hide()">
  <div class="rkn-overlay" x-show="open" x-cloak x-transition.opacity @click="hide()"></div>
  <aside class="fixed inset-block-0 inset-inline-end-0 z-drawer flex w-[92%] max-w-md flex-col bg-surface shadow-2xl" x-show="open" x-cloak
         x-transition:enter="transition ease-emphasized duration-300" x-transition:enter-start="translate-x-full rtl:-translate-x-full" x-transition:enter-end="translate-x-0"
         x-transition:leave="transition ease-exit duration-200" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full rtl:-translate-x-full"
         x-trap.noscroll="open" role="dialog" aria-modal="true" aria-label="{{ trans('cart.title')|default('سلة المشتريات') }}">
    <header class="flex items-center justify-between border-b border-border p-4">
      <h2 class="flex items-center gap-2 text-base font-bold">{{ trans('cart.title')|default('سلة المشتريات') }}<span class="rkn-badge rkn-badge--primary" x-show="$store.badges.cart > 0" x-text="$store.badges.cart"></span></h2>
      <button class="rkn-btn rkn-btn--ghost rkn-btn--icon" @click="hide()" aria-label="{{ trans('common.close')|default('إغلاق') }}"><svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l8 8M14 6l-8 8"/></svg></button>
    </header>
    <div class="flex-1 overflow-y-auto p-4" aria-live="polite">
      <div x-show="$store.badges.cart === 0" class="flex flex-col items-center py-14 text-center">
        <div class="mb-5 grid size-20 place-items-center rounded-full bg-primary-50 text-primary-600"><svg class="size-9" aria-hidden="true"><use href="#icon-cart"></use></svg></div>
        <p class="text-lg font-bold">{{ trans('cart.empty')|default('سلة المشتريات فارغة') }}</p>
        <a href="{{ url.home|default('/') }}" class="rkn-btn rkn-btn--primary mt-6" @click="hide()">{{ trans('common.start_shopping')|default('ابدأ التسوق') }}</a>
      </div>
      <salla-cart-summary x-show="$store.badges.cart > 0"></salla-cart-summary>
    </div>
    <footer class="border-t border-border p-4" x-show="$store.badges.cart > 0" x-cloak>
      <a href="{{ url.get('cart')|default('/cart') }}" class="rkn-btn rkn-btn--outline rkn-btn--block mb-2">{{ trans('cart.title')|default('عرض السلة') }}</a>
      <a href="{{ url.get('checkout')|default('/checkout') }}" class="rkn-btn rkn-btn--primary rkn-btn--block rkn-btn--lg">{{ trans('cart.checkout')|default('إتمام الطلب') }}</a>
    </footer>
  </aside>
</div>
