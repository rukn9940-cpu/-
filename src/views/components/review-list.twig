{% set reviews = product.reviews|default([]) %}
<div class="mt-6 space-y-4">
  {% for review in reviews %}
    <article class="rkn-card p-4">
      <div class="mb-2 flex items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-full bg-primary-50 text-sm font-bold text-primary-700">{{ review.author|default('?')|slice(0, 1)|upper }}</span>
          <div>
            <p class="text-sm font-semibold text-content">{{ review.author|default(trans('reviews.anonymous')|default('عميل')) }}</p>
            <p class="text-xs text-content-subtle">{{ review.date }}</p>
          </div>
        </div>
        <div class="flex flex-col items-end gap-1">
          {% include 'components.rating-stars' with { value: review.rating|default(0) } %}
          {% if review.verified|default(false) %}<span class="rkn-badge rkn-badge--success"><svg class="size-3" viewBox="0 0 20 20" fill="currentColor"><path d="M8 13l-3-3 1.4-1.4L8 10.2l5.6-5.6L15 6z"/></svg>{{ trans('reviews.verified')|default('شراء موثّق') }}</span>{% endif %}
        </div>
      </div>
      <p class="text-sm leading-relaxed text-content-muted">{{ review.body|default(review.content) }}</p>
    </article>
  {% else %}
    {% include 'components.empty-state' with { icon: 'star', title: trans('reviews.empty_title')|default('لا توجد تقييمات بعد'), message: trans('reviews.empty_message')|default('كن أول من يقيّم هذا المنتج.') } %}
  {% endfor %}

  {% if theme.settings.reviews_provider|default('salla') == 'salla' %}
    <salla-product-rating product-id="{{ product.id }}"></salla-product-rating>
  {% endif %}
</div>
