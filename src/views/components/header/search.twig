{#
  header/search.twig — Smart search input + suggestions panel
  @summary  Debounced quick-search against the Salla SDK with product results,
            keyword suggestions and recent searches. Provider-agnostic markup.
  @a11y  combobox pattern: role=combobox/listbox, aria-expanded, aria-controls
#}
<div class="relative w-full" x-data="rknSmartSearch()" @click.outside="open = false">
  <form role="search" @submit.prevent="submit()" class="relative">
    <label for="rkn-search" class="sr-only">{{ trans('common.search') }}</label>
    <span class="pointer-events-none absolute inset-block-0 inset-inline-start-0 flex items-center ps-3.5 text-content-subtle">
      <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="9" cy="9" r="6"/><path d="M14 14l4 4"/>
      </svg>
    </span>
    <input id="rkn-search" type="search" autocomplete="off"
           class="rkn-input ps-11 pe-4 h-12 rounded-full"
           placeholder="{{ trans('search.placeholder')|default('ابحث عن كاميرات، أنظمة، شبكات…') }}"
           x-model="q" @input="onInput()" @focus="open = q.length > 1 || recent.length > 0"
           role="combobox" aria-expanded="false" :aria-expanded="open" aria-controls="rkn-search-panel" aria-autocomplete="list">
  </form>

  {# --- Suggestions panel --- #}
  <div id="rkn-search-panel" x-show="open" x-cloak x-transition.opacity
       class="absolute inset-block-start-full inset-inline-0 z-dropdown mt-2 overflow-hidden rounded-xl border border-border bg-surface shadow-xl"
       role="listbox">
    {# Loading #}
    <template x-if="loading">
      <div class="space-y-3 p-4">{% include 'components/ui/skeleton.twig' with { variant: 'line', count: 3 } only %}</div>
    </template>

    {# Recent searches (empty query) #}
    <template x-if="!loading && q.length < 2 && recent.length">
      <div class="p-3">
        <div class="mb-2 flex items-center justify-between px-2">
          <span class="text-xs font-semibold text-content-subtle">{{ trans('search.recent')|default('عمليات بحث سابقة') }}</span>
          <button class="text-xs text-primary-600 hover:underline" @click="clearRecent()">{{ trans('common.clear')|default('مسح') }}</button>
        </div>
        <template x-for="term in recent" :key="term">
          <button class="rkn-navlink w-full justify-start" @click="pick(term)" x-text="term"></button>
        </template>
      </div>
    </template>

    {# Results #}
    <template x-if="!loading && q.length >= 2">
      <div>
        <template x-if="results.products.length">
          <ul class="max-h-80 divide-y divide-border overflow-auto">
            <template x-for="p in results.products" :key="p.id">
              <li role="option">
                <a :href="p.url" class="flex items-center gap-3 p-3 transition hover:bg-surface-sunken">
                  <img :src="p.image?.url || p.image || p.thumbnail" :alt="p.name"
                       class="size-12 rounded-lg border border-border object-cover" loading="lazy" width="48" height="48">
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-sm font-medium text-content" x-text="p.name"></span>
                    <span class="block text-sm font-semibold text-primary-600" x-text="$currency(p.price?.amount ?? p.price)"></span>
                  </span>
                </a>
              </li>
            </template>
          </ul>
        </template>
        <template x-if="!results.products.length">
          <p class="p-6 text-center text-sm text-content-muted">{{ trans('search.no_results')|default('لا توجد نتائج') }}</p>
        </template>
        <button class="block w-full border-t border-border bg-surface-sunken p-3 text-center text-sm font-semibold text-primary-700 hover:bg-primary-50"
                @click="submit()">
          {{ trans('search.view_all_results')|default('عرض كل النتائج') }}
        </button>
      </div>
    </template>
  </div>
</div>
