{#
  header/mega-menu.twig — desktop mega navigation with rich dropdown panels
  @summary  Security-category aware mega menu. Hover + keyboard accessible,
            one panel open at a time, RTL-correct panel alignment.
  @param menu  array  navigation tree: [{ id, title, url, columns:[{title, links:[{name,url}]}], featured:{image,title,url} }]
  @a11y  menubar pattern; Esc closes; arrow/enter open panels
#}
<nav class="hidden lg:block" x-data="rknMegaMenu()" @keydown.escape="close()"
     aria-label="{{ trans('nav.primary')|default('التنقل الرئيسي') }}">
  <ul class="flex items-center gap-1">
    {% for item in menu|default([]) %}
      {% set hasPanel = item.columns is defined and item.columns is not empty %}
      <li class="static" @mouseenter="{{ hasPanel ? "openPanel('#{item.id}')" : '' }}" @mouseleave="scheduleClose()">
        <a href="{{ item.url|default('#') }}"
           class="rkn-navlink"
           {% if hasPanel %}@focus="openPanel('{{ item.id }}')" @keydown="onKey($event, '{{ item.id }}')"
           :aria-expanded="isOpen('{{ item.id }}')" aria-haspopup="true"{% endif %}>
          {{ item.title }}
          {% if hasPanel %}<svg class="size-4 text-content-subtle" viewBox="0 0 20 20" fill="currentColor"><path d="M5 7l5 5 5-5z"/></svg>{% endif %}
        </a>

        {% if hasPanel %}
          <div x-show="isOpen('{{ item.id }}')" x-cloak
               x-transition:enter="transition ease-entrance duration-200"
               x-transition:enter-start="opacity-0 -translate-y-1" x-transition:enter-end="opacity-100 translate-y-0"
               @mouseenter="openPanel('{{ item.id }}')" @mouseleave="scheduleClose()"
               class="absolute inset-inline-0 inset-block-start-full z-dropdown mt-1 border-t border-border bg-surface shadow-xl">
            <div class="rkn-container grid grid-cols-12 gap-8 py-8">
              <div class="col-span-9 grid grid-cols-4 gap-x-8 gap-y-6">
                {% for col in item.columns %}
                  <div>
                    <h3 class="mb-3 text-sm font-bold text-content">{{ col.title }}</h3>
                    <ul class="space-y-1.5">
                      {% for link in col.links %}
                        <li><a href="{{ link.url }}" class="block text-sm text-content-muted transition hover:text-primary-700">{{ link.name }}</a></li>
                      {% endfor %}
                    </ul>
                  </div>
                {% endfor %}
              </div>
              {% if item.featured %}
                <a href="{{ item.featured.url }}" class="group col-span-3 relative overflow-hidden rounded-xl bg-surface-sunken">
                  <img src="{{ item.featured.image }}" alt="{{ item.featured.title }}"
                       class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy">
                  <span class="absolute inset-block-end-0 inset-inline-0 bg-gradient-to-t from-slate-950/80 to-transparent p-4">
                    <span class="text-base font-bold text-white">{{ item.featured.title }}</span>
                  </span>
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
