{#
  header/mobile-nav.twig — off-canvas mobile navigation drawer
  @param menu  array  same tree as mega-menu
  @a11y  dialog drawer; focus trap via Alpine focus; Esc + overlay close
#}
<div x-data="rknMobileNav()" x-show="$store.ui.mobileNav" x-cloak class="lg:hidden"
     @keydown.escape.window="$store.ui.close('mobileNav')">
  {# Overlay #}
  <div class="rkn-overlay" x-show="$store.ui.mobileNav" x-transition.opacity @click="$store.ui.close('mobileNav')"></div>

  {# Panel (slides from inline-start) #}
  <div class="fixed inset-block-0 inset-inline-start-0 z-drawer flex w-[86%] max-w-sm flex-col bg-surface shadow-2xl"
       x-show="$store.ui.mobileNav"
       x-transition:enter="transition ease-emphasized duration-300"
       x-transition:enter-start="-translate-x-full rtl:translate-x-full" x-transition:enter-end="translate-x-0"
       x-transition:leave="transition ease-exit duration-200"
       x-transition:leave-start="translate-x-0" x-transition:leave-end="-translate-x-full rtl:translate-x-full"
       x-trap.noscroll="$store.ui.mobileNav" role="dialog" aria-modal="true"
       aria-label="{{ trans('common.menu') }}">
    <div class="flex items-center justify-between border-b border-border p-4">
      <span class="text-base font-bold">{{ trans('common.menu') }}</span>
      <button class="rkn-btn rkn-btn--ghost rkn-btn--icon" @click="$store.ui.close('mobileNav')" aria-label="{{ trans('common.close') }}">
        <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l8 8M14 6l-8 8"/></svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto p-2" aria-label="{{ trans('nav.primary')|default('التنقل') }}">
      <ul class="space-y-0.5">
        {% for item in menu|default([]) %}
          {% set hasChildren = item.columns is defined and item.columns is not empty %}
          <li>
            {% if hasChildren %}
              <button class="rkn-navlink w-full justify-between" @click="toggle('{{ item.id }}')"
                      :aria-expanded="expanded === '{{ item.id }}'">
                {{ item.title }}
                <svg class="size-4 transition" :class="expanded === '{{ item.id }}' && 'rotate-180'" viewBox="0 0 20 20" fill="currentColor"><path d="M5 7l5 5 5-5z"/></svg>
              </button>
              <div x-show="expanded === '{{ item.id }}'" x-collapse class="ps-3">
                {% for col in item.columns %}
                  <p class="px-3 pt-2 text-xs font-bold text-content-subtle">{{ col.title }}</p>
                  {% for link in col.links %}
                    <a href="{{ link.url }}" class="rkn-navlink w-full justify-start text-content-muted">{{ link.name }}</a>
                  {% endfor %}
                {% endfor %}
              </div>
            {% else %}
              <a href="{{ item.url|default('#') }}" class="rkn-navlink w-full justify-start">{{ item.title }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</div>
