{% set items = items|default([
  { icon: 'shield', title: trans('trust.warranty')|default('ضمان معتمد') },
  { icon: 'badge-check', title: trans('trust.authentic')|default('منتجات أصلية') },
  { icon: 'lock', title: trans('trust.secure_checkout')|default('دفع آمن') },
  { icon: 'tool', title: trans('trust.installation_available')|default('تركيب احترافي') }
]) %}
{% if layout|default('inline') == 'grid' %}
  <ul class="grid grid-cols-2 gap-4 md:grid-cols-4">
    {% for it in items %}
      <li class="flex flex-col items-center gap-2 rounded-xl border border-border bg-surface p-5 text-center">
        <span class="grid size-12 place-items-center rounded-full bg-primary-50 text-primary-600"><svg class="size-6" aria-hidden="true"><use href="#icon-{{ it.icon }}"></use></svg></span>
        <span class="text-sm font-bold text-content">{{ it.title }}</span>
        {% if it.text %}<span class="text-xs text-content-muted">{{ it.text }}</span>{% endif %}
      </li>
    {% endfor %}
  </ul>
{% else %}
  <ul class="grid grid-cols-2 gap-3 rounded-xl border border-border bg-surface-sunken p-4">
    {% for it in items %}
      <li class="flex items-center gap-2.5"><svg class="size-6 shrink-0 text-primary-600" aria-hidden="true"><use href="#icon-{{ it.icon }}"></use></svg><span class="text-xs font-semibold text-content">{{ it.title }}</span></li>
    {% endfor %}
  </ul>
{% endif %}
