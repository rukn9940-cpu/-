{% set dir = trans('dir')|default('rtl') %}
{% set theme_mode = theme.settings.enable_dark_mode|default(false) ? 'dark' : 'light' %}
<!DOCTYPE html>
<html lang="{{ request.locale|default('ar') }}" dir="{{ dir }}" data-theme="{{ theme_mode }}" data-numerals="{{ theme.settings.numerals|default('western') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{ theme.settings.color_primary|default('#0057FF') }}">
  <meta name="format-detection" content="telephone=no">

  <title>{% block title %}{{ page.title|default(store.name) }}{% endblock %}</title>

  {% block seo %}
    <meta name="description" content="{{ page.description|default(store.description) }}">
    <link rel="canonical" href="{{ page.canonical|default(url.current) }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ store.name }}">
    <meta property="og:title" content="{{ page.title|default(store.name) }}">
    <meta property="og:description" content="{{ page.description|default(store.description) }}">
    <meta property="og:locale" content="{{ request.locale == 'en' ? 'en_US' : 'ar_SA' }}">
    {% if store.logo %}<meta property="og:image" content="{{ store.logo }}">{% endif %}
    <meta name="twitter:card" content="summary_large_image">
  {% endblock %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "Organization", "name": {{ store.name|json_encode|raw }}, "url": {{ (url.home|default(url.current))|json_encode|raw }}{% if store.logo %}, "logo": {{ store.logo|json_encode|raw }}{% endif %} },
      { "@type": "WebSite", "name": {{ store.name|json_encode|raw }}, "url": {{ (url.home|default(url.current))|json_encode|raw }},
        "potentialAction": { "@type": "SearchAction", "target": "{{ url.home|default('/') }}?s={search_term_string}", "query-input": "required name=search_term_string" } }
    ]
  }
  </script>

  {% hook 'head' %}
  {% block head %}{% endblock %}
</head>

<body class="min-h-dvh bg-bg font-sans text-content antialiased" dir="{{ dir }}">
  {% hook 'body:start' %}

  {% include 'components.icon-sprite' %}

  <a href="#main" class="rkn-skip-link">{{ trans('common.skip_to_content')|default('تخطٍّ إلى المحتوى') }}</a>

  {% include 'components.header' %}

  <main id="main" role="main" tabindex="-1">
    {% block content %}{% endblock %}
  </main>

  {% include 'components.footer' %}

  {% hook 'body:end' %}
  {% block scripts %}{% endblock %}
</body>
</html>
