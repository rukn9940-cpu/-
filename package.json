    "format": "prettier --write \"src/**/*.{js,css,json}\" \"*.md\""
  },
  "dependencies": {
    "alpinejs": "^3.14.1",
    "@alpinejs/focus": "^3.14.1",
    "@alpinejs/collapse": "^3.14.1"
  },
  "devDependencies": {
    "@salla.sa/cli": "^2.0.0",
    "@salla.sa/twilight": "^2.0.0",
    "@salla.sa/twilight-components": "^1.0.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "postcss-import": "^16.1.0",
    "prettier": "^3.3.2",
    "stylelint": "^16.6.1",
    "stylelint-config-standard": "^36.0.1",
    "tailwindcss": "^3.4.4",
    "tailwindcss-logical": "^3.0.1"
  },
  "engines": {
    "node": ">=18"
