{
  "name": "rkn-premium-theme",
  "version": "1.0.0",
  "description": "RKN Premium Theme — premium security-systems Salla storefront (RTL/Arabic-first).",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "salla theme serve",
    "build": "salla theme build",
