{
  "name": "rkn-premium",
  "title": {
    "ar": "ركن الاحتراف — بريميوم",
    "en": "RKN Premium"
  },
  "description": {
    "ar": "تجربة متجر فاخرة لأنظمة الأمن والمراقبة — تصميم احترافي يدعم العربية وRTL.",
    "en": "A premium security-systems storefront experience — Arabic & RTL-first, enterprise-grade."
  },
  "version": "1.0.0",
  "twilight": "^2.0.0",
  "author": { "name": "RKN — ركن الاحتراف" },
  "support_rtl": true,
  "default_language": "ar",
  "supported_languages": ["ar", "en"],
  "color_scheme": "light",
  "features": [
    "product.options", "product.gallery", "wishlist", "compare",
    "cart.drawer", "search.suggestions", "reviews.native"
  ],
  "fonts": { "primary": "Inter", "arabic": "IBM Plex Sans Arabic" },
  "settings": [
    {
      "id": "brand",
      "label": { "ar": "الهوية البصرية", "en": "Brand" },
      "fields": [
        { "id": "color_primary", "type": "color", "label": { "ar": "اللون الأساسي", "en": "Primary color" }, "default": "#0057FF" },
        { "id": "color_secondary", "type": "color", "label": { "ar": "اللون الثانوي", "en": "Secondary color" }, "default": "#FFC107" },
        { "id": "color_accent", "type": "color", "label": { "ar": "لون التمييز", "en": "Accent color" }, "default": "#0F172A" }
      ]
    },
    {
      "id": "appearance",
      "label": { "ar": "المظهر", "en": "Appearance" },
      "fields": [
        { "id": "enable_dark_mode", "type": "boolean", "label": { "ar": "تفعيل الوضع الليلي", "en": "Enable dark mode" }, "default": false },
        { "id": "numerals", "type": "select", "label": { "ar": "نظام الأرقام", "en": "Numerals" },
          "options": [
            { "value": "western", "label": { "ar": "أرقام إنجليزية 0123", "en": "Western 0123" } },
            { "value": "arabic", "label": { "ar": "أرقام عربية ٠١٢٣", "en": "Arabic-Indic ٠١٢٣" } }
          ], "default": "western" }
      ]
    },
    {
      "id": "header",
      "label": { "ar": "الترويسة", "en": "Header" },
      "fields": [
        { "id": "topbar_text", "type": "string", "label": { "ar": "نص الشريط العلوي", "en": "Top bar text" }, "default": "" },
        { "id": "topbar_link", "type": "string", "label": { "ar": "رابط الشريط العلوي", "en": "Top bar link" }, "default": "" },
        { "id": "show_compare", "type": "boolean", "label": { "ar": "إظهار المقارنة", "en": "Show compare" }, "default": true }
      ]
    },
    {
      "id": "homepage",
      "label": { "ar": "الصفحة الرئيسية", "en": "Homepage" },
      "fields": [
        { "id": "hero_slides", "type": "collection", "label": { "ar": "شرائح الواجهة", "en": "Hero slides" },
          "fields": [
            { "id": "title", "type": "string", "label": { "ar": "العنوان", "en": "Title" } },
            { "id": "subtitle", "type": "string", "label": { "ar": "الوصف", "en": "Subtitle" } },
            { "id": "image", "type": "image", "label": { "ar": "الصورة", "en": "Image" } },
            { "id": "cta_label", "type": "string", "label": { "ar": "نص الزر", "en": "Button label" } },
            { "id": "cta_url", "type": "string", "label": { "ar": "رابط الزر", "en": "Button URL" } }
          ] },
        { "id": "home_categories", "type": "categories", "label": { "ar": "أقسام الواجهة", "en": "Homepage categories" } },
        { "id": "collection_offers", "type": "category", "label": { "ar": "قسم العروض", "en": "Offers collection" } },
        { "id": "collection_ip", "type": "category", "label": { "ar": "قسم كاميرات IP", "en": "IP cameras collection" } },
        { "id": "collection_solar", "type": "category", "label": { "ar": "قسم الكاميرات الشمسية", "en": "Solar cameras collection" } },
        { "id": "collection_4g", "type": "category", "label": { "ar": "قسم كاميرات 4G", "en": "4G cameras collection" } },
        { "id": "collection_wifi", "type": "category", "label": { "ar": "قسم كاميرات واي فاي", "en": "WiFi cameras collection" } },
        { "id": "collection_nvr", "type": "category", "label": { "ar": "قسم NVR و DVR", "en": "NVR & DVR collection" } },
        { "id": "collection_accessories", "type": "category", "label": { "ar": "قسم الإكسسوارات", "en": "Accessories collection" } }
      ]
    },
    {
      "id": "reviews",
      "label": { "ar": "التقييمات", "en": "Reviews" },
      "fields": [
        { "id": "reviews_provider", "type": "select", "label": { "ar": "مصدر التقييمات", "en": "Reviews provider" },
          "options": [
            { "value": "salla", "label": { "ar": "تقييمات سلة", "en": "Salla native" } },
            { "value": "google", "label": { "ar": "تقييمات جوجل", "en": "Google reviews" } }
          ], "default": "salla" },
        { "id": "google_place_id", "type": "string", "label": { "ar": "معرّف نشاط جوجل", "en": "Google Place ID" }, "default": "" }
      ]
    },
    {
      "id": "performance",
      "label": { "ar": "الأداء", "en": "Performance" },
      "fields": [
        { "id": "lazy_images", "type": "boolean", "label": { "ar": "تحميل الصور الكسول", "en": "Lazy-load images" }, "default": true }
      ]
    }
  ]
}
